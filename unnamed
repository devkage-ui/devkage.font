function S:UpdateUi(dt)
    if not self.Gui then return end
    local now = os.clock()

    if now - self.State.LastUiSync >= 0.05 then
        self.State.LastUiSync = now
        local open, linked = self:IsDevKageMenuOpen()
        self.State.MainMenuLinked = linked
        self.State.GuiOpen = open
        self.Gui.Enabled = open
    end

    if now - self.State.LastThemeUpdate >= 0.20 then
        self.State.LastThemeUpdate = now
        self:ApplyAccent()
    end

    if self.StatusLabel then
        if not self.Config.ShowStatus then
            self.StatusLabel.Text = ""
        else
            local ping = math.floor(self:GetPing() * 1000 + 0.5)
            local mask = (ENV.__DevKageMaskShard and "mask:on") or "mask:off"
            local phase = self.Config.Enabled and self.State.Phase or "off"
            local rage = self.Config.RageEnabled and (self.State.RageLastStatus or "on") or "off"
            local silent = self.Config.SilentEnabled and (self.State.SilentLastStatus or "on") or "off"
            local owner
            if tostring(self.Config.CoexistenceMode) == "Passive" then
                owner = "passive"
            elseif self.State.ExternalDetected or self:IsExternalBackoffActive() then
                owner = "external"
            elseif self.State.OwnsRoot then
                owner = "suite"
            else
                owner = "local"
            end
            self.StatusLabel.Text = string.format(
                "rage:%s | silent:%s | void:%s | owner:%s | %dms | %s",
                rage,
                silent,
                phase,
                owner,
                ping,
                mask
            )
        end
    end

    if self.RageTargetLabel then
        local target = self.State.RageTarget
        local targetName = self.State.RageLastTargetName or "-"
        local hp = tonumber(self.State.RageLastTargetHP) or 0
        local immune = target and self.Config.RageRespectImmune
            and self:IsTargetImmune(self.State.RageTargetPlayer, target)
        self.RageTargetLabel.Text = string.format(
            "target: %s | %.0f hp | %s%s",
            targetName,
            hp,
            tostring(self.State.RageLastStatus or "idle"),
            immune and " | immune" or ""
        )
    end

    if self.SilentTargetLabel then
        self.SilentTargetLabel.Text = string.format(
            "silent: %s | %s",
            tostring(self.State.SilentLastTargetName or "-"),
            tostring(self.State.SilentLastStatus or "idle")
        )
    end
end

function S:HandleKey(input, processed)
    if processed then return end
    if self.Services.UserInputService:GetFocusedTextBox() then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    local name = input.KeyCode.Name

    if self.Config.RageKey ~= "None" and name == self.Config.RageKey then
        self.Config.RageEnabled = not self.Config.RageEnabled
        if self.Config.RageEnabled then
            self:RefreshCombatModules()
            self:AcquireRageTarget(true)
        else
            self:ClearRageTarget()
            self.State.RageLastStatus = "off"
        end
        self:SaveConfig()
        self:RefreshAllControls()
        return
    end

    if self.Config.SilentKey ~= "None" and name == self.Config.SilentKey then
        self.Config.SilentEnabled = not self.Config.SilentEnabled
        if self.Config.SilentEnabled then
            self:RefreshCombatModules()
            self:AcquireSilentTarget(true)
        else
            self:ClearSilentTarget()
            self.State.SilentLastStatus = "off"
        end
        self:SaveConfig()
        self:RefreshAllControls()
        return
    end

    if self.Config.VoidKey ~= "None" and name == self.Config.VoidKey then
        self.Config.Enabled = not self.Config.Enabled
        if self.Config.Enabled then
            self:SetPhase("attack")
        else
            self:SetPhase("attack")
            self:RestoreOwnedLocal(true)
        end
        self:SaveConfig()
        self:RefreshAllControls()
        return
    end

    if self.Config.AntiAimKey ~= "None" and name == self.Config.AntiAimKey then
        self.Config.AntiAimEnabled = not self.Config.AntiAimEnabled
        self:SaveConfig()
        self:RefreshAllControls()
        return
    end

    if self.Config.SpinKey ~= "None" and name == self.Config.SpinKey then
        self.Config.SpinEnabled = not self.Config.SpinEnabled
        self:SaveConfig()
        self:RefreshAllControls()
        return
    end

    if name == self.Config.FallbackUiKey and not self.State.MainMenuLinked then
        self.State.FallbackVisible = not self.State.FallbackVisible
    end
end

function S:OnCharacterAdded()
    self:RestoreOwnedLocal(true)
    self:ResetVoidState(false)
    self:RestoreAutoRotate()
    self:ClearRageTarget()
    self:ClearSilentTarget()
    self.State.ServerCF = nil
    self.State.ExternalServerCF = nil
    self.State.ExternalOwnerUntil = 0
    self.State.ExternalDetected = false
    self.State.RageLastStatus = self.Config.RageEnabled and "respawn" or "off"
    self.State.SilentLastStatus = self.Config.SilentEnabled and "respawn" or "off"
    task.delay(0.5, function()
        if not self.Running then return end
        self:RefreshCombatModules()
        if self.Config.RageEnabled and self.Config.RageAutoTarget then
            self:AcquireRageTarget(true)
        end
        if self.Config.SilentEnabled then
            self:AcquireSilentTarget(true)
        end
    end)
end

function S:RegisterMaskShard()
    local mask = ENV.__DevKageMaskShard
    if type(mask) ~= "table" or type(mask.Runtime) ~= "table" then return end
    self.MaskPredictionExport = function(part, origin)
        return self:PredictPart(part, origin)
    end
    mask.Runtime.VoidSuite = self
    mask.Runtime.VoidPrediction = self.MaskPredictionExport
    if self.RageExport then mask.Runtime.RageBot = self.RageExport end
    if self.SilentExport then mask.Runtime.SilentAim = self.SilentExport end
    if self.AntiAimExport then mask.Runtime.AntiAim = self.AntiAimExport end
end

function S:UnregisterMaskShard()
    local mask = ENV.__DevKageMaskShard
    if type(mask) == "table" and type(mask.Runtime) == "table" then
        if mask.Runtime.VoidSuite == self then mask.Runtime.VoidSuite = nil end
        if mask.Runtime.VoidPrediction == self.MaskPredictionExport then
            mask.Runtime.VoidPrediction = nil
        end
        if mask.Runtime.RageBot == self.RageExport then mask.Runtime.RageBot = nil end
        if mask.Runtime.SilentAim == self.SilentExport then mask.Runtime.SilentAim = nil end
        if mask.Runtime.AntiAim == self.AntiAimExport then mask.Runtime.AntiAim = nil end
    end
    self.MaskPredictionExport = nil
end

function S:StartLoops()
    -- Targeting/fire loop. It never replaces Gun/Melee/CameraController methods.
    self:Track(self.Services.RunService.Heartbeat:Connect(function(dt)
        if not self.Running then return end
        local ok, err = pcall(function()
            self:UpdateCombatFire(dt or 0)
        end)
        if not ok then
            self.State.LastError = tostring(err)
        end
    end))

    -- One server-CFrame writer for Void + Rage positioning + Anti-Aim.
    -- This is intentionally PostSimulation so local rendering can be restored separately.
    self:Track(self.Services.RunService.PostSimulation:Connect(function(dt)
        if not self.Running then return end
        local ok, err = pcall(function()
            self:PostSimulationStep(dt or 0)
        end)
        if not ok then
            self.State.LastError = tostring(err)
            if self.Config.AutoRecover then
                pcall(function() self:RestoreOwnedLocal(true) end)
            end
        end
    end))

    -- Probe before normal render-priority 0 restores. This catches another script
    -- that wrote its server CFrame after our PostSimulation callback.
    self:Bind("DK_HVHCompanion_ExternalProbe", Enum.RenderPriority.First.Value - 100, function()
        if not self.Running then return end
        self:PreRenderExternalProbe()
    end)

    -- Restore only frames that this companion itself wrote. If another script owns
    -- server CFrame, this does nothing and leaves that script's restore loop alone.
    self:Bind("DK_HVHCompanion_LocalRestore", Enum.RenderPriority.First.Value, function()
        if not self.Running then return end
        if self.State.OwnRootFrame then
            self:RestoreOwnedLocal(false)
        end
    end)

    self:Bind("DK_HVHCompanion_UI", Enum.RenderPriority.Last.Value + 4, function(dt)
        if not self.Running then return end
        self:UpdateUi(dt or 0)
    end)
end

function S:Unload(reason)
    if not self.Running then return end
    self.Running = false
    pcall(function() self:RestoreOwnedLocal(true) end)
    pcall(function() self:RestoreLocal(true) end) -- v1.2 cleanup compatibility
    pcall(function() self:RestoreAutoRotate() end)
    pcall(function() self:ClearRageTarget() end)
    pcall(function() self:ClearSilentTarget() end)
    self:UnbindAll()
    self:DisconnectAll()
    self:UnregisterMaskShard()

    if self.Gui then
        pcall(function() self.Gui:Destroy() end)
        self.Gui = nil
    end

    if ENV.DevKageVoidSuite == self then ENV.DevKageVoidSuite = nil end
    if ENV.DevKageVoidPredict == self.PredictionExport then ENV.DevKageVoidPredict = nil end
    if ENV.DevKageVoidOrigin == self.OriginExport then ENV.DevKageVoidOrigin = nil end
    if ENV.DevKageRageBot == self.RageExport then ENV.DevKageRageBot = nil end
    if ENV.DevKageSilentAim == self.SilentExport then ENV.DevKageSilentAim = nil end
    if ENV.DevKageAntiAim == self.AntiAimExport then ENV.DevKageAntiAim = nil end
end

function S:BootStep(name, callback)
    self.State.LastStatus = "boot:" .. tostring(name)
    local ok, result = pcall(callback)
    if not ok then
        error("[VoidSuite boot:" .. tostring(name) .. "] " .. tostring(result), 0)
    end
    return result
end

function S:Init()
    self:BootStep("config", function()
        self:LoadConfig()
        self:SetPhase("attack")
    end)

    self:BootStep("player", function()
        self.Player = self.Services.Players.LocalPlayer or self.Services.Players.PlayerAdded:Wait()
        if not game:IsLoaded() then
            game.Loaded:Wait()
        end
    end)
    if not self.Running then return end

    self:BootStep("controllers", function()
        local playerScripts = self.Player:WaitForChild("PlayerScripts", 15)
        if playerScripts then
            playerScripts:WaitForChild("Controllers", 8)
        end
        self:RefreshCombatModules()
    end)

    self:BootStep("ui", function()
        self:BuildGui()
    end)

    self:BootStep("maskshard", function()
        self:RegisterMaskShard()
    end)

    self:BootStep("exports", function()
        self.PredictionExport = function(part, origin)
            return self:PredictPart(part, origin)
        end
        self.OriginExport = function()
            return self:GetCombatOrigin("Auto")
        end
        self.RageExport = {
            Acquire = function(force) return self:AcquireRageTarget(force == true) end,
            Clear = function() return self:ClearRageTarget() end,
            Fire = function() return self:FireRageShot() end,
            GetTarget = function() return self.State.RageTarget end,
            Predict = function(part, origin) return self:PredictRagePart(part, origin or self:GetRageOrigin()) end,
            GetStatus = function() return self.State.RageLastStatus end,
            GetServerOrigin = function() return self:GetCombatOrigin("Auto") end,
            ApplyDeadlyPreset = function() return self:ApplyPreset("Deadly Extreme") end,
            Suite = self,
        }
        self.SilentExport = {
            Acquire = function(force) return self:AcquireSilentTarget(force == true) end,
            Clear = function() return self:ClearSilentTarget() end,
            Fire = function() return self:FireSilentShot() end,
            GetTarget = function() return self.State.SilentTarget end,
            Predict = function(part, origin) return self:PredictSilentPart(part, origin or self:GetSilentOrigin()) end,
            GetStatus = function() return self.State.SilentLastStatus end,
            Suite = self,
        }
        self.AntiAimExport = {
            GetRotation = function(dt) return self:GetAntiAimRotation(dt or 0) end,
            GetServerCF = function() return self.State.ServerCF end,
            IsExternalOwner = function() return self.State.ExternalDetected or self:IsExternalBackoffActive() end,
            Suite = self,
        }

        ENV.DevKageVoidPredict = self.PredictionExport
        ENV.DevKageVoidOrigin = self.OriginExport
        ENV.DevKageRageBot = self.RageExport
        ENV.DevKageSilentAim = self.SilentExport
        ENV.DevKageAntiAim = self.AntiAimExport

        -- MaskShard may have appeared after the first registration pass.
        self:RegisterMaskShard()
    end)

    self:BootStep("signals", function()
        self:Track(self.Services.UserInputService.InputBegan:Connect(function(input, processed)
            self:HandleKey(input, processed)
        end))

        self:Track(self.Player.CharacterAdded:Connect(function()
            if self.Config.RespawnProof then
                self:OnCharacterAdded()
            else
                self:ResetVoidState(true)
            end
        end))

        self:Track(self.Services.Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            -- Listener only; no camera function is replaced.
        end))
    end)

    self:BootStep("loops", function()
        local delay = math.max(tonumber(self.Config.CoexistenceBootDelay) or 0, 0)
        if delay > 0 then
            task.wait(delay)
        end
        self:StartLoops()
    end)

    self.Ready = true
    self.State.LastStatus = "ready"
end

task.spawn(function()
    local ok, err = pcall(function()
        S:Init()
    end)
    if not ok then
        S.State.LastError = tostring(err)
        S.State.LastStatus = "error"
        pcall(function()
            warn("[DevKage Void Suite] " .. tostring(err))
        end)
        if S.Config and S.Config.AutoRecover then
            pcall(function() S:RestoreLocal(true) end)
        end
    end
end)

return S
