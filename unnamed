function S:Track(connection)
    if connection then
        self.Connections[#self.Connections + 1] = connection
    end
    return connection
end

function S:Bind(name, priority, callback)
    pcall(function()
        self.Services.RunService:UnbindFromRenderStep(name)
    end)
    local ok = pcall(function()
        self.Services.RunService:BindToRenderStep(name, priority, callback)
    end)
    if ok then
        self.BoundSteps[name] = true
    end
    return ok
end

function S:UnbindAll()
    for name in pairs(self.BoundSteps) do
        pcall(function()
            self.Services.RunService:UnbindFromRenderStep(name)
        end)
    end
    self.BoundSteps = {}
end

function S:DisconnectAll()
    for i = #self.Connections, 1, -1 do
        local c = self.Connections[i]
        self.Connections[i] = nil
        pcall(function()
            c:Disconnect()
        end)
    end
end

function S:MergeConfig(source)
    if type(source) ~= "table" then return end
    for k, default in pairs(self.Defaults) do
        local value = source[k]
        if value ~= nil and type(value) == type(default) then
            self.Config[k] = value
        end
    end
end

function S:LoadConfig()
    if not (isfile and readfile) then return false end
    local ok, decoded = pcall(function()
        if not isfile(self.ConfigPath) then return nil end
        local raw = readfile(self.ConfigPath)
        if type(raw) ~= "string" or raw == "" then return nil end
        return self.Services.HttpService:JSONDecode(raw)
    end)
    if ok and type(decoded) == "table" then
        self:MergeConfig(decoded)
        return true
    end
    return false
end

function S:SaveConfig()
    if not self.Config.SaveSettings then return end
    if not (writefile and self.Services.HttpService) then return end
    pcall(function()
        if makefolder and isfolder and not isfolder(self.ConfigFolder) then
            makefolder(self.ConfigFolder)
        elseif makefolder and not isfolder then
            pcall(makefolder, self.ConfigFolder)
        end
        writefile(self.ConfigPath, self.Services.HttpService:JSONEncode(self.Config))
    end)
end

function S:ResetConfig()
    for k, v in pairs(self.Defaults) do
        self.Config[k] = v
    end
    self:SaveConfig()
    if self.RefreshAllControls then
        self:RefreshAllControls()
    end
end

function S:GetPing()
    local ping = 0
    pcall(function()
        local network = self.Services.Stats.Network
        local item = network and network.ServerStatsItem and network.ServerStatsItem["Data Ping"]
        if item then
            ping = (tonumber(item:GetValue()) or 0) / 1000
        end
    end)
    return math.clamp(ping, 0, 1.5)
end

function S:GetCharacter()
    local p = self.Player or self.Services.Players.LocalPlayer
    return p and p.Character or nil
end

function S:GetHumanoid()
    local char = self:GetCharacter()
    return char and char:FindFirstChildOfClass("Humanoid") or nil
end

function S:RefreshFighterController()
    local p = self.Player
    if not p then return end
    local playerScripts = p:FindFirstChild("PlayerScripts")
    local controllers = playerScripts and playerScripts:FindFirstChild("Controllers")
    local module = controllers and controllers:FindFirstChild("FighterController")
    if not module or not module:IsA("ModuleScript") then return end

    local loader = ENV.InstanceRequire
    local ok, controller
    if type(loader) == "function" then
        ok, controller = pcall(loader, module, 2)
    else
        ok, controller = pcall(require, module)
    end
    if ok and type(controller) == "table" then
        self.State.FighterController = controller
    end
end


function S:SafeRequireModule(moduleRef, timeoutSec)
    if not moduleRef or typeof(moduleRef) ~= "Instance" or not moduleRef:IsA("ModuleScript") then
        return nil
    end

    local loader = ENV.InstanceRequire
    local ok, result
    if type(loader) == "function" then
        ok, result = pcall(loader, moduleRef, timeoutSec or 2)
    else
        ok, result = pcall(require, moduleRef)
    end

    if ok and type(result) == "table" then
        return result
    end
    return nil
end

function S:RefreshCombatModules()
    self:RefreshFighterController()

    local rs = self.Services.ReplicatedStorage
    local modules = rs and rs:FindFirstChild("Modules")
    if modules then
        local enumsRef = modules:FindFirstChild("EnumLibrary")
        local utilityRef = modules:FindFirstChild("Utility")

        local enums = self:SafeRequireModule(enumsRef, 2)
        if enums then
            self.State.EnumLibrary = enums
        end

        local utility = self:SafeRequireModule(utilityRef, 2)
        if utility then
            self.State.Utility = utility
        end
    end

    local playerScripts = self.Player and self.Player:FindFirstChild("PlayerScripts")
    local controllers = playerScripts and playerScripts:FindFirstChild("Controllers")
    local mechanicsRef = controllers and controllers:FindFirstChild("MechanicsController")
    local mechanics = self:SafeRequireModule(mechanicsRef, 2)
    if mechanics then
        self.State.MechanicsController = mechanics
    end
end

function S:GetRoot()
    local controller = self.State.FighterController
    if controller and controller.LocalFighter then
        local entity = controller.LocalFighter.Entity
        local root = entity and entity.RootPart
        if root and typeof(root) == "Instance" and root:IsA("BasePart") and root.Parent then
            self.State.FighterSource = "fighter"
            return root
        end
    end

    local char = self:GetCharacter()
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then
        self.State.FighterSource = "character"
        return root
    end
    return nil
end

function S:IsAlive()
    local hum = self:GetHumanoid()
    local root = self:GetRoot()
    return hum ~= nil and hum.Health > 0 and root ~= nil
end

function S:ExternalMovementBusy()
    if not self.Config.RespectOtherMovement then return false end
    if ENV.InstanceUndergroundEnabled == true then return true end
    if rawget(_G, "keyheldcframe") == true then return true end
    if rawget(_G, "keyheldcframefly") == true then return true end
    if ENV.__DEVKAGE_LATE_BOOT_WAITING == true then return true end
    return false
end


function S:IsExternalBackoffActive()
    return os.clock() < (tonumber(self.State.ExternalOwnerUntil) or 0)
end

function S:MarkExternalOwner(cf, reason)
    if cf then
        self.State.ExternalServerCF = cf
    end
    self.State.ExternalOwnerUntil = os.clock() + math.max(tonumber(self.Config.ExternalBackoff) or 0.35, 0.05)
    self.State.ExternalDetected = true
    self.State.ExternalReason = reason or "external"
    self.State.OwnsRoot = false
    self.State.OwnRootFrame = false
end

function S:DetectExternalServerState(root)
    if not root or not root.Parent then return false end

    local mode = tostring(self.Config.CoexistenceMode or "Enhance")
    if mode == "Standalone" then
        self.State.ExternalDetected = false
        self.State.ExternalReason = nil
        return false
    end

    if self:ExternalMovementBusy() then
        self:MarkExternalOwner(root.CFrame, "known movement")
        return true
    end

    if mode == "Passive" then
        self.State.ExternalServerCF = root.CFrame
        self.State.ExternalDetected = true
        self.State.ExternalReason = "passive"
        return true
    end

    local visible = self.State.VisibleCF or self.State.LocalRestoreCF
    local observed = root.CFrame
    local threshold = math.max(tonumber(self.Config.ExternalDesyncThreshold) or 80, 10)

    if visible then
        local displacement = (observed.Position - visible.Position).Magnitude
        local ownCF = self.State.LastOwnServerCF
        local looksLikeOurWrite = false
        if ownCF then
            looksLikeOurWrite = (observed.Position - ownCF.Position).Magnitude < 6
        end

        if displacement >= threshold and not looksLikeOurWrite then
            self:MarkExternalOwner(observed, "server cf")
            return true
        end
    end

    if self:IsExternalBackoffActive() then
        self.State.ExternalServerCF = observed
        self.State.ExternalDetected = true
        return true
    end

    self.State.ExternalDetected = false
    self.State.ExternalReason = nil
    return false
end

function S:ShouldOwnRoot()
    local mode = tostring(self.Config.CoexistenceMode or "Enhance")
    if mode == "Passive" then return false end
    if mode == "Enhance" and self:IsExternalBackoffActive() then return false end
    if self:ExternalMovementBusy() then return false end

    local hasRootFeature =
        self.Config.Enabled
        or self.Config.AntiAimEnabled
        or self.Config.SpinEnabled
        or (self.Config.RageEnabled and tostring(self.Config.RageAttackPosition or "Current") ~= "Current")
        or (self.Config.SilentEnabled and self.Config.SilentManipulation)

    return hasRootFeature == true
end

function S:GetObservedServerOrigin()
    if self.Config.UseExternalServerOrigin and self.State.ExternalServerCF then
        if self:IsExternalBackoffActive() or tostring(self.Config.CoexistenceMode) == "Passive" then
            return self.State.ExternalServerCF.Position
        end
    end
    if self.State.ServerCF then
        return self.State.ServerCF.Position
    end
    return nil
end

function S:RandDuration(base)
    base = math.max(tonumber(base) or 0.2, 0.03)
    if not self.Config.RandomTiming then return base end
    local variance = math.clamp(tonumber(self.Config.TimingVariance) or 0, 0, 0.9)
    local lo = base * (1 - variance)
    local hi = base * (1 + variance)
    return lo + math.random() * (hi - lo)
end

function S:SetPhase(phase)
    self.State.Phase = phase
    self.State.PhaseStarted = os.clock()
    if phase == "hide" then
        self.State.PhaseDuration = self:RandDuration(self.Config.HideTime)
    else
        self.State.PhaseDuration = self:RandDuration(self.Config.AttackTime)
    end
end

function S:ResetVoidState(restore)
    if restore ~= false then
        self:RestoreLocal(true)
    end
    self.State.Snap = nil
    self.State.VisibleCF = nil
    self.State.LastVisiblePosition = nil
    self.State.LastVisibleSample = 0
    self.State.SmoothedSelfVelocity = Vector3.zero
    self:SetPhase("attack")
end

function S:SampleVisibleRoot(root, dt)
    if not root then return end
    local now = os.clock()
    local pos = root.Position
    local lastPos = self.State.LastVisiblePosition
    local lastAt = self.State.LastVisibleSample
    local measured = root.AssemblyLinearVelocity

    if lastPos and lastAt > 0 then
        local sampleDt = now - lastAt
        if sampleDt > 0.001 and sampleDt < 0.25 then
            local deltaVel = (pos - lastPos) / sampleDt
            if deltaVel.Magnitude < 600 then
                measured = measured:Lerp(deltaVel, 0.45)
            end
        end
    end

    local alpha = math.clamp(tonumber(self.Config.PredictionSmoothing) or 0.58, 0, 0.98)
    self.State.SmoothedSelfVelocity = self.State.SmoothedSelfVelocity:Lerp(measured, 1 - alpha)
    self.State.LastVisiblePosition = pos
    self.State.LastVisibleSample = now
    self.State.VisibleCF = root.CFrame
    self.State.VisibleLV = root.AssemblyLinearVelocity
    self.State.VisibleAV = root.AssemblyAngularVelocity
end

function S:AdvanceVisiblePrediction(dt)
    if not self.Config.VoidPrediction then return end
    local cf = self.State.VisibleCF
    if not cf then return end

    local velocity = self.State.SmoothedSelfVelocity
    local maxLead = math.max(tonumber(self.Config.MaxPredictionStuds) or 18, 0)
    local advance = velocity * math.max(dt or 0, 0) * math.max(tonumber(self.Config.PredictionMultiplier) or 1, 0)
    if advance.Magnitude > maxLead and advance.Magnitude > 0 then
        advance = advance.Unit * maxLead
    end
    self.State.VisibleCF = cf + advance
end

function S:GetVisibleCF(root)
    return self.State.VisibleCF or (root and root.CFrame) or CFrame.new()
end

function S:GetVisibleOrigin()
    local root = self:GetRoot()
    local cf = self:GetVisibleCF(root)
    return cf.Position
end

function S:BuildVoidCFrame(root)
    local visible = self:GetVisibleCF(root)
    local p = visible.Position
    local mode = self.Config.VoidMode
    local range = math.max(tonumber(self.Config.VoidRange) or 9000, 50)
    local depth = math.max(tonumber(self.Config.VoidDepth) or 250000, 500)

    if mode == "Random" then
        p = Vector3.new(
            math.random(-math.floor(range), math.floor(range)),
            -depth,
            math.random(-math.floor(range), math.floor(range))
        )
    elseif mode == "Extreme" then
        local scale = math.clamp(tonumber(self.Config.ExtremeScale) or 1750000000, 100000, 2000000000)
        local function edge()
            local n = math.random(math.floor(scale * 0.68), math.floor(scale))
            return math.random(0, 1) == 0 and -n or n
        end
        p = Vector3.new(edge(), edge(), edge())
    elseif mode == "Sky" then
        p = Vector3.new(p.X, depth, p.Z)
    else
        p = Vector3.new(p.X, -depth, p.Z)
    end

    local _, y, _ = visible:ToOrientation()
    return CFrame.new(p) * CFrame.Angles(0, y, 0)
end

function S:ApplyVoidPulse(root, dt)
    if not root or not root.Parent then return end

    if not self.State.Snap or self.State.Snap.root ~= root then
        self.State.Snap = {
            root = root,
            cf = self:GetVisibleCF(root),
            lv = root.AssemblyLinearVelocity,
            av = root.AssemblyAngularVelocity,
        }
    else
        self.State.Snap.cf = self:GetVisibleCF(root)
        self.State.Snap.lv = self.State.VisibleLV
        self.State.Snap.av = self.State.VisibleAV
    end

    self:AdvanceVisiblePrediction(dt)
    self.State.Snap.cf = self:GetVisibleCF(root)

    local voidCF = self:BuildVoidCFrame(root)
    local spinCF = self:GetSpinRotation(dt, true)
    if spinCF then
        voidCF = voidCF * spinCF
    end

    pcall(function()
        root.CFrame = voidCF
        if self.Config.VelocityNoise then
            local n = math.floor(math.max(tonumber(self.Config.VelocityNoiseAmount) or 2500, 0))
            root.AssemblyLinearVelocity = Vector3.new(
                math.random(-n, n),
                math.random(-n, n),
                math.random(-n, n)
            )
        end
    end)
end

function S:RestoreLocal(force)
    local snap = self.State.Snap
    if not snap then return end
    local root = snap.root
    if not root or not root.Parent then
        self.State.Snap = nil
        return
    end

    pcall(function()
        local restoreCF = self.State.VisibleCF or snap.cf
        if restoreCF then
            root.CFrame = restoreCF
        end
        if snap.lv then root.AssemblyLinearVelocity = snap.lv end
        if snap.av then root.AssemblyAngularVelocity = snap.av end
    end)

    if force then
        self.State.Snap = nil
    end
end

function S:UpdateVoid(dt)
    if not self.Config.Enabled then
        if self.State.Snap then self:RestoreLocal(true) end
        return
    end
    if self:ExternalMovementBusy() then
        if self.State.Snap then self:RestoreLocal(true) end
        self.State.LastStatus = "paused: movement"
        return
    end
    if not self:IsAlive() then
        if self.State.Snap then self:RestoreLocal(true) end
        self.State.LastStatus = "waiting for fighter"
        return
    end

    local root = self:GetRoot()
    if not root then return end

    local elapsed = os.clock() - self.State.PhaseStarted
    if elapsed >= self.State.PhaseDuration then
        if self.State.Phase == "hide" then
            self:SetPhase("attack")
            self:RestoreLocal(true)
        else
            self:SetPhase("hide")
            self.State.VisibleCF = root.CFrame
            self.State.VisibleLV = root.AssemblyLinearVelocity
            self.State.VisibleAV = root.AssemblyAngularVelocity
        end
    end

    if self.State.Phase == "hide" then
        self:ApplyVoidPulse(root, dt)
        self.State.LastStatus = "void: hide"
    else
        self:SampleVisibleRoot(root, dt)
        self.State.LastStatus = "void: attack"
    end
end

function S:GetTargetVelocity(part)
    if not part or not part.Parent then return Vector3.zero end
    local now = os.clock()
    local cache = self.VelocityCache[part]
    local assembly = part.AssemblyLinearVelocity or Vector3.zero

    if not cache then
        cache = {
            pos = part.Position,
            time = now,
            vel = assembly,
        }
        self.VelocityCache[part] = cache
        return cache.vel
    end

    local dt = now - cache.time
    local measured = assembly
    if dt > 0.001 and dt < 0.25 then
        local sampled = (part.Position - cache.pos) / dt
        if sampled.Magnitude < 1000 then
            measured = assembly:Lerp(sampled, 0.50)
        end
    end

    local smooth = math.clamp(tonumber(self.Config.PredictionSmoothing) or 0.58, 0, 0.98)
    cache.vel = cache.vel:Lerp(measured, 1 - smooth)
    cache.pos = part.Position
    cache.time = now
    return cache.vel
end

function S:PredictPart(part, origin)
    if not part or typeof(part) ~= "Instance" or not part:IsA("BasePart") then
        return nil
    end

    local base = part.Position
    if not self.Config.VoidPrediction then
        return base
    end

    origin = origin or self:GetVisibleOrigin()
    local distance = (base - origin).Magnitude
    local t = 0

    if self.Config.ProjectileAssist then
        local speed = math.max(tonumber(self.Config.ProjectileSpeed) or 3000, 1)
        t = t + (distance / speed)
    end
    if self.Config.PingAssist then
        t = t + (self:GetPing() * math.max(tonumber(self.Config.PingFactor) or 1, 0))
    end

    t = t * math.max(tonumber(self.Config.PredictionMultiplier) or 1, 0)
    t = math.min(t, math.max(tonumber(self.Config.PredictionMaxLead) or 0.35, 0))

    local velocity = self:GetTargetVelocity(part)
    local offset = velocity * t
    local cap = math.max(tonumber(self.Config.MaxPredictionStuds) or 18, 0)
    if cap > 0 and offset.Magnitude > cap then
        offset = offset.Unit * cap
    end
    return base + offset
end


