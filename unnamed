    local lf = self:GetLocalFighter()
    return lf and lf.EquippedItem or nil
end

function S:GetRageAmmo()
    local item = self:GetEquippedItem()
    if not item then return 0, 0, false, false end

    local name = tostring(self:ItemGet(item, "Name") or item.Name or "")
    local melee = self:IsMeleeItem(item)
    if self.RageInfiniteAmmoNames[name] then
        return nil, nil, false, false
    end

    local current = tonumber(self:ItemGet(item, "CurrentAmmo") or self:ItemGet(item, "Ammo"))
    local maximum = tonumber(self:ItemGet(item, "MaxAmmo") or self:ItemGet(item, "MaxBullets"))
    local reloading = false
    for _, key in ipairs({ "Reloading", "IsReloading", "IsReload" }) do
        local value = self:ItemGet(item, key)
        if value == true or value == 1 or value == "true" then
            reloading = true
            break
        end
    end

    if melee then
        return nil, nil, true, false
    end
    return current, maximum, false, reloading
end


function S:GetWeaponCooldown()
    local item = self:GetEquippedItem()
    if not item then return 0.05 end

    local info = nil
