        TextSize = 13,
        Font = self:Font(),
        ZIndex = 8,
    })

    local bar = self:Create("Frame", {
        Parent = row,
        Position = UDim2.fromOffset(31, 25),
        Size = UDim2.new(1, -62, 0, 8),
        BackgroundColor3 = Color3.fromRGB(12, 12, 12),
        BorderColor3 = Color3.fromRGB(55, 55, 55),
        Active = true,
        ZIndex = 7,
    })
    local fill = self:Create("Frame", {
        Parent = bar,
        Size = UDim2.new(0, 0, 1, 0),
        BorderSizePixel = 0,
        ZIndex = 8,
    })
    self:Accent(fill)

    local dragging = false
    local function quantize(value)
        value = math.clamp(value, minValue, maxValue)
        step = step or 1
        if step > 0 then
            value = math.floor((value / step) + 0.5) * step
        end
        return math.clamp(value, minValue, maxValue)
    end
    local function set(value, save)
        value = quantize(value)
        self.Config[key] = value
        local frac = (value - minValue) / math.max(maxValue - minValue, 0.0001)
        fill.Size = UDim2.new(frac, 0, 1, 0)
        local decimals = (step and step < 1) and 2 or 0
        valueLabel.Text = string.format("%." .. decimals .. "f%s", value, suffix or "")
        if callback then pcall(callback, value) end
        if save then self:SaveConfig() end
    end
    local function fromMouse()
        local m = self.Services.UserInputService:GetMouseLocation()
        local frac = math.clamp((m.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        set(minValue + (maxValue - minValue) * frac, false)
    end
    local function refresh()
        set(tonumber(self.Config[key]) or minValue, false)
    end
    self.ControlRefreshers[#self.ControlRefreshers + 1] = refresh

    self:Track(bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            fromMouse()
        end
    end))
    self:Track(self.Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            fromMouse()
        end
    end))
    self:Track(self.Services.UserInputService.InputEnded:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            self:SaveConfig()
        end
    end))
    self:Track(minus.MouseButton1Click:Connect(function()
        set((tonumber(self.Config[key]) or minValue) - (step or 1), true)
    end))
    self:Track(plus.MouseButton1Click:Connect(function()
        set((tonumber(self.Config[key]) or minValue) + (step or 1), true)
    end))
    return row
end

function S:AddCycle(parent, key, text, values, callback)
    local row = self:Row(parent, 27)
    local label = self:MakeText(row, text, 12, 7)
    label.Position = UDim2.fromOffset(8, 0)
    label.Size = UDim2.new(0.55, -8, 1, 0)

    local button = self:Create("TextButton", {
        Parent = row,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0.43, 0, 0, 19),
        BackgroundColor3 = Color3.fromRGB(17, 17, 17),
        BorderColor3 = Color3.fromRGB(55, 55, 55),
        Text = "",
        TextColor3 = Color3.fromRGB(220, 220, 220),
        TextSize = 11,
        Font = self:Font(),
        AutoButtonColor = false,
        ZIndex = 8,
    })

    local function refresh()
        button.Text = tostring(self.Config[key])
    end
    self.ControlRefreshers[#self.ControlRefreshers + 1] = refresh

    self:Track(button.MouseButton1Click:Connect(function()
        local current = self.Config[key]
        local idx = 1
        for i, v in ipairs(values) do
            if v == current then idx = i break end
        end
        idx = (idx % #values) + 1
        self.Config[key] = values[idx]
        refresh()
        self:SaveConfig()
        if callback then pcall(callback, self.Config[key]) end
    end))
    return row
end

