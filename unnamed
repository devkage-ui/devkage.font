function S:RefreshAllControls()
    for _, fn in ipairs(self.ControlRefreshers or {}) do
        pcall(fn)
    end
end

function S:UpdateUi(dt)
    if not self.Gui then return end
    local now = os.clock()

    if now - self.State.LastUiSync >= 0.05 then
        self.State.LastUiSync = now
        local open, linked = self:IsDevKageMenuOpen()
        self.State.MainMenuLinked = linked
        self.State.GuiOpen = open
        self.Gui.Enabled = open
    end

    if now - self.State.LastThemeUpdate >= 0.20 then
        self.State.LastThemeUpdate = now
        self:ApplyAccent()
    end

    if self.StatusLabel then
        if not self.Config.ShowStatus then
            self.StatusLabel.Text = ""
        else
            local ping = math.floor(self:GetPing() * 1000 + 0.5)
            local mask = (ENV.__DevKageMaskShard and "mask:on") or "mask:off"
            local phase = self.Config.Enabled and self.State.Phase or "off"
            local spin = self.Config.SpinEnabled and self.Config.SpinMode or "off"
            local rage = self.Config.RageEnabled and (self.State.RageLastStatus or "on") or "off"
            self.StatusLabel.Text = string.format(
                "rage:%s | void:%s | spin:%s | %dms | %s | root:%s",
                rage,
                phase,
                spin,
                ping,
                mask,
                self.State.FighterSource or "?"
            )
        end
    end

    if self.RageTargetLabel then
        local target = self.State.RageTarget
        local targetName = self.State.RageLastTargetName or "-"
        local hp = tonumber(self.State.RageLastTargetHP) or 0
        local immune = target and self.Config.RageRespectImmune
            and self:IsTargetImmune(self.State.RageTargetPlayer, target)
        self.RageTargetLabel.Text = string.format(
            "target: %s | %.0f hp | %s%s",
            targetName,
            hp,
            tostring(self.State.RageLastStatus or "idle"),
            immune and " | immune" or ""
        )
    end
end

function S:HandleKey(input, processed)
    if processed then return end
    if self.Services.UserInputService:GetFocusedTextBox() then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    local name = input.KeyCode.Name

    if self.Config.RageKey ~= "None" and name == self.Config.RageKey then
        self.Config.RageEnabled = not self.Config.RageEnabled
        if self.Config.RageEnabled then
            self:RefreshCombatModules()
            self:AcquireRageTarget(true)
        else
            self:ClearRageTarget()
            self.State.RageLastStatus = "off"
        end
        self:SaveConfig()
        self:RefreshAllControls()
        return
    end

    if self.Config.VoidKey ~= "None" and name == self.Config.VoidKey then
        self.Config.Enabled = not self.Config.Enabled
        if self.Config.Enabled then self:SetPhase("attack") else self:ResetVoidState(true) end
        self:SaveConfig()
        self:RefreshAllControls()
        return
    end

    if self.Config.SpinKey ~= "None" and name == self.Config.SpinKey then
        self.Config.SpinEnabled = not self.Config.SpinEnabled
        if not self.Config.SpinEnabled then self:RestoreAutoRotate() end
        self:SaveConfig()
        self:RefreshAllControls()
        return
    end

    if name == self.Config.FallbackUiKey and not self.State.MainMenuLinked then
        self.State.FallbackVisible = not self.State.FallbackVisible
    end
end

function S:OnCharacterAdded()
    self:ResetVoidState(false)
    self:RestoreAutoRotate()
    self:ClearRageTarget()
    self.State.RageLastStatus = self.Config.RageEnabled and "respawn" or "off"
    task.delay(0.5, function()
        if not self.Running then return end
        self:RefreshCombatModules()
        if self.Config.RageEnabled and self.Config.RageAutoTarget then
            self:AcquireRageTarget(true)
        end
    end)
end

function S:RegisterMaskShard()
    local mask = ENV.__DevKageMaskShard
    if type(mask) ~= "table" or type(mask.Runtime) ~= "table" then return end
    self.MaskPredictionExport = function(part, origin)
        return self:PredictPart(part, origin)
    end
    mask.Runtime.VoidSuite = self
    mask.Runtime.VoidPrediction = self.MaskPredictionExport
    if self.RageExport then
        mask.Runtime.RageBot = self.RageExport
    end
end

function S:UnregisterMaskShard()
    local mask = ENV.__DevKageMaskShard
    if type(mask) == "table" and type(mask.Runtime) == "table" then
        if mask.Runtime.VoidSuite == self then mask.Runtime.VoidSuite = nil end
        if mask.Runtime.VoidPrediction == self.MaskPredictionExport then
            mask.Runtime.VoidPrediction = nil
        end
        if mask.Runtime.RageBot == self.RageExport then
            mask.Runtime.RageBot = nil
        end
    end
    self.MaskPredictionExport = nil
end

function S:StartLoops()
    self:Track(self.Services.RunService.Heartbeat:Connect(function(dt)
        if not self.Running then return end
        local ok, err = pcall(function()
            self:UpdateVoid(dt or 0)
            self:UpdateRage(dt or 0)
        end)
        if not ok then
            self.State.LastError = tostring(err)
            if self.Config.AutoRecover then
                pcall(function() self:RestoreLocal(true) end)
            end
        end
    end))

    self:Bind("DK_VoidSuite_LocalRestore", Enum.RenderPriority.Camera.Value - 8, function(dt)
        if not self.Running then return end
        if self.State.Snap then
            self:RestoreLocal(false)
        end
    end)

    self:Bind("DK_VoidSuite_Spin", Enum.RenderPriority.Camera.Value + 2, function(dt)
        if not self.Running then return end
        self:UpdateSpin(dt or 0)
    end)

    self:Bind("DK_VoidSuite_UI", Enum.RenderPriority.Last.Value + 4, function(dt)
        if not self.Running then return end
        self:UpdateUi(dt or 0)
    end)
end

function S:Unload(reason)
    if not self.Running then return end
    self.Running = false
    pcall(function() self:RestoreLocal(true) end)
    pcall(function() self:RestoreAutoRotate() end)
    pcall(function() self:ClearRageTarget() end)
    self:UnbindAll()
    self:DisconnectAll()
    self:UnregisterMaskShard()

    if self.Gui then
        pcall(function() self.Gui:Destroy() end)
        self.Gui = nil
    end

    if ENV.DevKageVoidSuite == self then
        ENV.DevKageVoidSuite = nil
    end
    if ENV.DevKageVoidPredict == self.PredictionExport then
        ENV.DevKageVoidPredict = nil
    end
    if ENV.DevKageVoidOrigin == self.OriginExport then
        ENV.DevKageVoidOrigin = nil
    end
    if ENV.DevKageRageBot == self.RageExport then
        ENV.DevKageRageBot = nil
    end
end

function S:BootStep(name, callback)
    self.State.LastStatus = "boot:" .. tostring(name)
    local ok, result = pcall(callback)
    if not ok then
        error("[VoidSuite boot:" .. tostring(name) .. "] " .. tostring(result), 0)
    end
    return result
end

function S:Init()
    self:BootStep("config", function()
        self:LoadConfig()
        self:SetPhase("attack")
    end)

    self:BootStep("player", function()
        self.Player = self.Services.Players.LocalPlayer or self.Services.Players.PlayerAdded:Wait()
        if not game:IsLoaded() then
            game.Loaded:Wait()
        end
    end)
    if not self.Running then return end

    self:BootStep("controllers", function()
        local playerScripts = self.Player:WaitForChild("PlayerScripts", 15)
        if playerScripts then
            playerScripts:WaitForChild("Controllers", 8)
        end
        self:RefreshCombatModules()
    end)

    self:BootStep("ui", function()
        self:BuildGui()
    end)

    self:BootStep("maskshard", function()
        self:RegisterMaskShard()
    end)

    self:BootStep("exports", function()
        self.PredictionExport = function(part, origin)
            return self:PredictPart(part, origin)
        end
        self.OriginExport = function()
            return self:GetVisibleOrigin()
        end
        self.RageExport = {
            Acquire = function(force) return self:AcquireRageTarget(force == true) end,
            Clear = function() return self:ClearRageTarget() end,
            Fire = function() return self:FireRageShot() end,
            GetTarget = function() return self.State.RageTarget end,
            Predict = function(part, origin) return self:PredictRagePart(part, origin or self:GetRageOrigin()) end,
            GetStatus = function() return self.State.RageLastStatus end,
            Suite = self,
        }
        ENV.DevKageVoidPredict = self.PredictionExport
        ENV.DevKageVoidOrigin = self.OriginExport
        ENV.DevKageRageBot = self.RageExport

        -- MaskShard may have appeared after the first registration pass.
        self:RegisterMaskShard()
    end)

    self:BootStep("signals", function()
        self:Track(self.Services.UserInputService.InputBegan:Connect(function(input, processed)
            self:HandleKey(input, processed)
        end))

        self:Track(self.Player.CharacterAdded:Connect(function()
            if self.Config.RespawnProof then
                self:OnCharacterAdded()
            else
                self:ResetVoidState(true)
            end
        end))

        self:Track(self.Services.Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            -- Listener only; no camera function is replaced.
        end))
    end)

    self:BootStep("loops", function()
        self:StartLoops()
    end)

    self.Ready = true
    self.State.LastStatus = "ready"
end

task.spawn(function()
    local ok, err = pcall(function()
        S:Init()
    end)
    if not ok then
        S.State.LastError = tostring(err)
        S.State.LastStatus = "error"
        pcall(function()
            warn("[DevKage Void Suite] " .. tostring(err))
        end)
        if S.Config and S.Config.AutoRecover then
            pcall(function() S:RestoreLocal(true) end)
        end
    end
end)

return S
