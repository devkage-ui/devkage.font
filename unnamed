end

function S:EquipRageWeapon()
    if not self.Config.RageForceWeapon then return true end

    local slot = self:GetDesiredRageSlot()
    if not slot then return true end

    local lf = self:GetLocalFighter()
    if not lf then return false end

    local equipped = lf.EquippedItem
    if equipped and self:GetItemSlot(equipped) == slot then
        return true
    end

    local now = os.clock()
    if now - (self.State.RageLastEquip or 0) < 0.08 then
        return false
    end
    self.State.RageLastEquip = now

    local desired = self:FindRageSlotItem(slot)

    pcall(function()
        if type(lf.SwitchToSlot) == "function" then lf:SwitchToSlot(slot) end
    end)
    pcall(function()
        if type(lf.EquipItem) == "function" then lf:EquipItem(slot) end
    end)
    pcall(function()
        if type(lf.Equip) == "function" then lf:Equip(slot) end
    end)

    local fc = self.State.FighterController
    if fc then
        pcall(function()
            if type(fc.SwitchItem) == "function" then fc:SwitchItem(slot) end
        end)
        pcall(function()
            if type(fc.EquipItem) == "function" then fc:EquipItem(slot) end
        end)
    end

    local useItem = self.Services.ReplicatedStorage
        and self.Services.ReplicatedStorage:FindFirstChild("Remotes")
    useItem = useItem and useItem:FindFirstChild("Replication")
    useItem = useItem and useItem:FindFirstChild("Fighter")
    useItem = useItem and useItem:FindFirstChild("UseItem")

    local objectId = desired and self:ItemGet(desired, "ObjectID")
    if useItem and objectId ~= nil then
        for _, enumName in ipairs({ "Equip", "Switch", "Select", "EquipItem", "ChangeItem" }) do
            local enumValue = self:ToGameEnum(enumName)
            if enumValue ~= nil then
                pcall(function()
                    useItem:FireServer(objectId, enumValue, nil, nil)
                end)
            end
        end
    end

    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local key = ({ Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three })[slot]
        if key then
            vim:SendKeyEvent(true, key, false, game)
            task.defer(function()
                pcall(function()
                    vim:SendKeyEvent(false, key, false, game)
                end)
            end)
        end
    end)

    return true
end

function S:GetMuzzlePosition()
    local viewModels = self.Services.Workspace:FindFirstChild("ViewModels")
    local firstPerson = viewModels and viewModels:FindFirstChild("FirstPerson")
    if not firstPerson then return nil end

    local playerName = self.Player and self.Player.Name or ""
    for _, model in ipairs(firstPerson:GetChildren()) do
        if model:IsA("Model") then
            local name = model.Name or ""
            local belongs = playerName == "" or string.find(name, playerName, 1, true) ~= nil
            if belongs then
                local itemVisual = model:FindFirstChild("ItemVisual")
                local body = itemVisual and itemVisual:FindFirstChild("Body")
                local primary = body and body:FindFirstChild("BodyPrimary")
                local muzzle = primary and primary:FindFirstChild("_muzzle")

                if muzzle and muzzle:IsA("Attachment") then
                    return muzzle.WorldPosition
                elseif muzzle and muzzle:IsA("BasePart") then
                    return muzzle.Position
                end

                for _, desc in ipairs(model:GetDescendants()) do
                    local low = string.lower(desc.Name or "")
                    if string.find(low, "muzzle", 1, true) or string.find(low, "barrel", 1, true) then
                        if desc:IsA("Attachment") then
                            return desc.WorldPosition
                        elseif desc:IsA("BasePart") then
                            return desc.Position
                        end
                    end
                end
            end
        end
    end
    return nil
end

function S:GetCombatOrigin(mode)
    mode = tostring(mode or "Auto")

    if mode == "Muzzle" then
        local muzzle = self:GetMuzzlePosition()
        if muzzle then return muzzle end
    elseif mode == "Root" or mode == "Visible" then
        local root = self:GetRoot()
        if mode == "Root" and root then
            return root.Position
        end
        return self:GetVisibleOrigin()
    elseif mode == "Server" then
        local serverOrigin = self:GetObservedServerOrigin()
        if serverOrigin then return serverOrigin end
        return self:GetVisibleOrigin()
    end

    -- Auto: prefer another script's observed server CFrame, then our own server CFrame,
    -- then visible/root. This is the coexistence path.
    local observed = self:GetObservedServerOrigin()
    if observed then return observed end
    local muzzle = self:GetMuzzlePosition()
    if muzzle and not self.Config.Enabled and not self.State.ExternalDetected then
        return muzzle
    end
    return self:GetVisibleOrigin()
end

function S:GetRageOrigin()
    return self:GetCombatOrigin(self.Config.RageOrigin)
end

function S:GetSilentOrigin()
    return self:GetCombatOrigin(self.Config.SilentOrigin)
end

function S:PredictRagePart(part, origin)
    if not part or typeof(part) ~= "Instance" or not part:IsA("BasePart") then
        return nil
    end

    local base = part.Position
    if not self.Config.RagePrediction then
        return base
    end

    origin = origin or self:GetRageOrigin()
    local distance = (base - origin).Magnitude
    local leadTime = 0

    if self.Config.ProjectileAssist then
        local speed = math.max(tonumber(self.Config.ProjectileSpeed) or 3000, 1)
        leadTime = leadTime + (distance / speed)
    end
    if self.Config.PingAssist then
        leadTime = leadTime + (self:GetPing() * math.max(tonumber(self.Config.PingFactor) or 1, 0))
    end

    leadTime = leadTime
        * math.max(tonumber(self.Config.PredictionMultiplier) or 1, 0)
        * math.max(tonumber(self.Config.RagePredictionScale) or 1, 0)
    leadTime = math.min(leadTime, math.max(tonumber(self.Config.PredictionMaxLead) or 0.35, 0))

    local velocity = self:GetTargetVelocity(part)
    local offset = velocity * leadTime
    local cap = math.max(tonumber(self.Config.MaxPredictionStuds) or 18, 0)
    if cap > 0 and offset.Magnitude > cap then
        offset = offset.Unit * cap
    end

    return base + offset
end


function S:PredictSilentPart(part, origin)
    if not part or typeof(part) ~= "Instance" or not part:IsA("BasePart") then
        return nil
    end

    local base = part.Position
    if not self.Config.SilentPrediction then
        return base
    end

    origin = origin or self:GetSilentOrigin()
    local distance = (base - origin).Magnitude
    local leadTime = 0

    if self.Config.ProjectileAssist then
        local speed = math.max(tonumber(self.Config.ProjectileSpeed) or 3000, 1)
        leadTime = leadTime + (distance / speed)
    end
    if self.Config.PingAssist then
        leadTime = leadTime + (self:GetPing() * math.max(tonumber(self.Config.PingFactor) or 1, 0))
    end

    leadTime = leadTime
        * math.max(tonumber(self.Config.PredictionMultiplier) or 1, 0)
        * math.max(tonumber(self.Config.SilentPredictionScale) or 1, 0)
    leadTime = math.min(leadTime, math.max(tonumber(self.Config.PredictionMaxLead) or 0.35, 0))

    local velocity = self:GetTargetVelocity(part)
    local offset = velocity * leadTime
    local cap = math.max(tonumber(self.Config.MaxPredictionStuds) or 18, 0)
    if cap > 0 and offset.Magnitude > cap then
        offset = offset.Unit * cap
    end

    return base + offset
end

function S:EncodeRageCFrame(cf)
    local utility = self.State.Utility
    if not utility then return cf end

    local ok, value = pcall(function()
        if type(utility.EncodeCFrame) == "function" then
            return utility:EncodeCFrame(cf)
        end
        return cf
    end)
    return ok and value or cf
end

function S:GetUseItemRemote()
    local rs = self.Services.ReplicatedStorage
    local remotes = rs and rs:FindFirstChild("Remotes")
    local replication = remotes and remotes:FindFirstChild("Replication")
    local fighter = replication and replication:FindFirstChild("Fighter")
    return fighter and fighter:FindFirstChild("UseItem") or nil
end

function S:CanRageFire()
    if not self.Config.RageEnabled or not self.Config.RageAutoShoot then
        return false, "off"
    end

    if self.Config.RageVoidSync and self.Config.Enabled and self.State.Phase == "hide" then
        return false, "void hide"
    end

    local item = self:GetEquippedItem()
    if not item then return false, "no weapon" end

    local current, _, melee, reloading = self:GetRageAmmo()
    if reloading then return false, "reloading" end
    if not melee and current ~= nil and current <= 0 then return false, "no ammo" end

    local interval = math.max(tonumber(self.Config.RageShotInterval) or 0.05, 0.01)
    if self.Config.RageUseWeaponCooldown then
        interval = math.max(interval, self:GetWeaponCooldown())
    end
    if self.Config.RagePingGate then
        interval = math.max(interval, math.min(self:GetPing() * 0.35, 0.12))
    end

    local now = os.clock()
    if now - (self.State.RageLastShot or 0) < interval then
        return false, "cooldown"
    end
    if now - (self.State.LastCombatShot or 0) < math.min(interval, 0.05) then
        return false, "shared cooldown"
    end

    return true, "ready"
end

function S:BuildShotData(hitPart, origin, targetPos)
    if not hitPart or not origin or not targetPos then return nil end
    local look = CFrame.new(origin, targetPos)
    return {
        [utf8.char(1)] = {
            [utf8.char(0)] = self:EncodeRageCFrame(look),
            [utf8.char(1)] = self:EncodeRageCFrame(look),
            [utf8.char(2)] = hitPart,
            [utf8.char(3)] = self:EncodeRageCFrame(CFrame.new(0.43, 0.25, 0.42)),
        },
    }
end

function S:FireRageShot()
    local target = self.State.RageTarget
    if not self:IsValidRageTarget(target) then
        return false, "invalid target"
    end

    local targetPlayer = self.State.RageTargetPlayer
    if self.Config.RageRespectImmune and self:IsTargetImmune(targetPlayer, target) then
        return false, "immune"
    end

    if self.Config.RageForceWeapon then
        self:EquipRageWeapon()
    end

    local canFire, reason = self:CanRageFire()
    if not canFire then return false, reason end

    local item = self:GetEquippedItem()
    local objectId = item and self:ItemGet(item, "ObjectID")
    if objectId == nil then return false, "object id" end

    local hitPart = self:GetRageHitPart(target)
    if not hitPart then return false, "hit part" end

    local origin = self:GetRageOrigin()
    local targetPos = self:PredictRagePart(hitPart, origin)
    if not origin or not targetPos then return false, "prediction" end

    local attackMode = tostring(self.Config.RageAttackMode or "Auto")
    local itemName = tostring(self:ItemGet(item, "Name") or item.Name or "")
    local actionName = "StartShooting"
    if attackMode == "Knife" or (attackMode == "Auto" and string.find(string.lower(itemName), "knife", 1, true)) then
        actionName = "StartAiming"
    end

    local startShooting = self:ToGameEnum(actionName)
    if startShooting == nil then
        self:RefreshCombatModules()
        startShooting = self:ToGameEnum(actionName)
    end
    if startShooting == nil then return false, "enum" end

    local remote = self:GetUseItemRemote()
    if not remote then return false, "remote" end

    local data = self:BuildShotData(hitPart, origin, targetPos)
    if not data then return false, "payload" end

    if self.Config.RageInputAssist then
        pcall(function()
            self:SyncWeaponInput(actionName)
        end)
    end

    local attempts = math.clamp(math.floor(tonumber(self.Config.RageShootAttempts) or 1), 1, 3)
    local fired = false
    local lastError = nil

    for _ = 1, attempts do
        local ok, err = pcall(function()
            remote:FireServer(objectId, startShooting, data, nil)
        end)
        if ok then
            fired = true
        else
            lastError = err
        end
    end

    if fired then
        local now = os.clock()
        self.State.RageLastShot = now
        self.State.LastCombatShot = now
        self.State.RageLastFireError = nil
        return true, "firing"
    end

    self.State.RageLastFireError = tostring(lastError)
    return false, "fire error"
end

function S:UpdateRageTarget(dt)
    if not self.Config.RageEnabled then
        if self.State.RageTarget then
            self:ClearRageTarget()
        end
        self.State.RageLastStatus = "off"
        return false
    end

    if self.Config.RageMatchOnly and not self:IsActiveMatch() then
        self:ClearRageTarget()
        self.State.RageLastStatus = "waiting match"
        return false
    end

    if not self:IsAlive() then
        self:ClearRageTarget()
        self.State.RageLastStatus = "waiting fighter"
        return false
    end

    local target = self.State.RageTarget
    local valid = target and self:IsValidRageTarget(target)

    if valid and self.Config.RageRespectImmune
        and self:IsTargetImmune(self.State.RageTargetPlayer, target) then
        self.State.RageLastStatus = "target immune"
        if not self.Config.RageStickyTarget and self.Config.RageAutoTarget then
            self:ClearRageTarget()
            target = nil
            valid = false
        end
    end

    if self.Config.RageAutoTarget then
        if not valid or not self.Config.RageStickyTarget then
            target = self:AcquireRageTarget(false)
            valid = target and self:IsValidRageTarget(target)
        end
    elseif not valid then
        self:ClearRageTarget()
        target = nil
    end

    if not target then
        self.State.RageLastStatus = "searching"
        return false
    end

    local hum = target:FindFirstChildOfClass("Humanoid")
    self.State.RageLastTargetName = self.State.RageTargetPlayer and self.State.RageTargetPlayer.Name or target.Name
    self.State.RageLastTargetHP = hum and hum.Health or 0

    if self.Config.RageVoidSync and self.Config.Enabled and self.State.Phase == "hide" then
        self.State.RageLastStatus = "void hide"
        return true
    end

    if self.Config.RageForceWeapon then
        self:EquipRageWeapon()
    end

    self.State.RageLastStatus = self.Config.RageAutoShoot and "ready" or "locked"
    return true
end

-- Backwards-compatible API name used by v1.2 exports.
function S:UpdateRage(dt)
    return self:UpdateRageTarget(dt)
end

function S:UpdateSilentTarget(dt)
    if not self.Config.SilentEnabled then
        if self.State.SilentTarget then self:ClearSilentTarget() end
        self.State.SilentLastStatus = "off"
        return false
    end

    if not self:IsAlive() then
        self:ClearSilentTarget()
        self.State.SilentLastStatus = "waiting fighter"
        return false
    end

    local target = self.State.SilentTarget
    if self.Config.SilentUseRageTarget and self:IsValidRageTarget(self.State.RageTarget) then
        target = self:AcquireSilentTarget(true)
    elseif not self:IsValidSilentTarget(target) then
        target = self:AcquireSilentTarget(false)
    end

    if not target then
        self.State.SilentLastStatus = "searching"
        return false
    end

    self.State.SilentLastTargetName = self.State.SilentTargetPlayer and self.State.SilentTargetPlayer.Name or target.Name
    self.State.SilentLastStatus = "ready"
    return true
end

function S:CanSilentFire()
    if not self.Config.SilentEnabled then return false, "off" end

    local uis = self.Services.UserInputService
    local mouseDown = false
    pcall(function()
        mouseDown = uis:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    end)

    if not self.Config.SilentAutoShoot then
        if self.Config.SilentOnlyWhenMouseDown and not mouseDown then
            return false, "mouse"
        elseif not self.Config.SilentOnlyWhenMouseDown and not mouseDown then
            return false, "manual"
        end
    end

    local chance = math.clamp(math.floor(tonumber(self.Config.SilentHitChance) or 100), 0, 100)
    if chance <= 0 then return false, "chance" end
    if chance < 100 and math.random(1, 100) > chance then
        return false, "miss roll"
    end

    local item = self:GetEquippedItem()
    if not item then return false, "no weapon" end

    local current, _, melee, reloading = self:GetRageAmmo()
    if reloading then return false, "reloading" end
    if not melee and current ~= nil and current <= 0 then return false, "no ammo" end

    local interval = math.max(tonumber(self.Config.SilentShotInterval) or 0.05, 0.01)
    local now = os.clock()
    if now - (self.State.SilentLastShot or 0) < interval then return false, "cooldown" end
    if now - (self.State.LastCombatShot or 0) < math.min(interval, 0.05) then
        return false, "shared cooldown"
    end
    return true, "ready"
end

function S:FireSilentShot()
    local target = self.State.SilentTarget
    if not self:IsValidSilentTarget(target) then
        target = self:AcquireSilentTarget(true)
    end
    if not target then return false, "no target" end

    local targetPlayer = self.State.SilentTargetPlayer
    if self.Config.SilentRespectImmune and self:IsTargetImmune(targetPlayer, target) then
        return false, "immune"
    end

    local canFire, reason = self:CanSilentFire()
    if not canFire then return false, reason end

    local item = self:GetEquippedItem()
    local objectId = item and self:ItemGet(item, "ObjectID")
    if objectId == nil then return false, "object id" end

    local part = self:GetSilentHitPart(target)
    if not part then return false, "hit part" end

    local origin = self:GetSilentOrigin()
    local targetPos = self:PredictSilentPart(part, origin)
    if not origin or not targetPos then return false, "prediction" end

    local startShooting = self:ToGameEnum("StartShooting")
    if startShooting == nil then
        self:RefreshCombatModules()
        startShooting = self:ToGameEnum("StartShooting")
    end
    if startShooting == nil then return false, "enum" end

    local remote = self:GetUseItemRemote()
    if not remote then return false, "remote" end

    local data = self:BuildShotData(part, origin, targetPos)
    if not data then return false, "payload" end

    local ok, err = pcall(function()
        remote:FireServer(objectId, startShooting, data, nil)
    end)

    if ok then
        local now = os.clock()
        self.State.SilentLastShot = now
        self.State.LastCombatShot = now
        self.State.SilentLastFireError = nil
        self.State.SilentLastStatus = "firing"
        return true, "firing"
    end

    self.State.SilentLastFireError = tostring(err)
    self.State.SilentLastStatus = "fire error"
    return false, "fire error"
end

function S:UpdateCombatFire(dt)
    local rageReady = self:UpdateRageTarget(dt)
    local silentReady = self:UpdateSilentTarget(dt)

    -- Rage gets first shot priority. Silent Aim becomes a fallback/assist when both are enabled,
    -- preventing duplicate remote spam while still helping when Rage has no valid shot.
    if rageReady and self.Config.RageEnabled and self.Config.RageAutoShoot then
        local fired, status = self:FireRageShot()
        self.State.RageLastStatus = status or (fired and "firing" or "ready")
        if fired then return true end
        if status == "void hide"
            or status == "reloading"
            or status == "no ammo"
            or status == "no weapon"
            or status == "cooldown"
            or status == "shared cooldown" then
            return false
        end
    end

    if silentReady and self.Config.SilentEnabled then
        local fired, status = self:FireSilentShot()
        self.State.SilentLastStatus = status or (fired and "firing" or "ready")
        return fired
    end

    if self.Config.RageInputAssist then
        local now = os.clock()
        if now - (self.State.RageLastFinish or 0) > 0.20 then
            self.State.RageLastFinish = now
            pcall(function() self:SyncWeaponInput("FinishShooting") end)
        end
    end

    return false
end



function S:UpdateCombatPhase()
    if not self.Config.Enabled then
        if self.State.Phase ~= "attack" then
            self:SetPhase("attack")
        end
        return
    end

    local elapsed = os.clock() - (self.State.PhaseStarted or 0)
    if elapsed >= (self.State.PhaseDuration or 0) then
        if self.State.Phase == "hide" then
            self:SetPhase("attack")
        else
            self:SetPhase("hide")
        end
    end
end

function S:GetCombatTargetPart()
    if self.Config.RageEnabled and self:IsValidRageTarget(self.State.RageTarget) then
        return self:GetRageHitPart(self.State.RageTarget)
    end
    if self.Config.SilentEnabled and self:IsValidSilentTarget(self.State.SilentTarget) then
        return self:GetSilentHitPart(self.State.SilentTarget)
    end
    return nil
end

function S:BuildRageAttackCFrame(root, dt)
    local visible = self.State.VisibleCF or (root and root.CFrame) or CFrame.new()
    if not self.Config.RageEnabled then return visible end

    local mode = tostring(self.Config.RageAttackPosition or "Current")
    if mode == "Current" then return visible end

    local target = self.State.RageTarget
    if not self:IsValidRageTarget(target) then return visible end
    local part = self:GetRageHitPart(target)
    if not part then return visible end

    local predicted = self:PredictRagePart(part, visible.Position) or part.Position
    local base = CFrame.new(predicted) * (part.CFrame - part.Position)
    local forward = tonumber(self.Config.RageAttackForward) or 2
    local height = tonumber(self.Config.RageAttackHeight) or 0

    if mode == "Under" then
        return CFrame.new(predicted + Vector3.new(0, -math.abs(height ~= 0 and height or 3.5), 0))
    elseif mode == "Orbit" then
        self.State.RageOrbitAngle = (self.State.RageOrbitAngle or 0)
            + math.max(tonumber(self.Config.RageOrbitSpeed) or 7, 0) * math.max(dt or 0, 0)
        local radius = math.max(tonumber(self.Config.RageOrbitRadius) or 3, 0)
        local offset = Vector3.new(
            math.cos(self.State.RageOrbitAngle) * radius,
            height,
            math.sin(self.State.RageOrbitAngle) * radius
        )
        return CFrame.new(predicted + offset)
    end

    -- Target: mirror the stronger reference's target-relative server position.
    return base * CFrame.new(0, height, forward)
end


function S:BuildSilentManipulationCFrame(root)
    local visible = self.State.VisibleCF or (root and root.CFrame) or CFrame.new()
    if not self.Config.SilentEnabled or not self.Config.SilentManipulation then
        return visible
    end

    local target = self.State.SilentTarget
    if not self:IsValidSilentTarget(target) then return visible end
    local part = self:GetSilentHitPart(target)
    if not part then return visible end

    local predicted = self:PredictSilentPart(part, visible.Position) or part.Position
    local base = CFrame.new(predicted) * (part.CFrame - part.Position)
    local forward = tonumber(self.Config.SilentManipulationForward) or 5
    local height = tonumber(self.Config.SilentManipulationHeight) or 5
    return base * CFrame.new(0, height, forward)
end

function S:GetFloorBelow(position)
    if not position then return nil end
    local now = os.clock()
    local cachedPos = self.State.FloorCachePos
    local cached = self.State.FloorCacheCF
    if cached and cachedPos and (cachedPos - position).Magnitude < 3
        and now - (self.State.FloorCacheAt or 0) < 0.20 then
        return cached
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local char = self:GetCharacter()
    params.FilterDescendantsInstances = char and { char } or {}

    local result = self.Services.Workspace:Raycast(position, Vector3.new(0, -500, 0), params)
    local cf = nil
    if result then
        local depth = math.max(tonumber(self.Config.AntiAimUndergroundDepth) or 2, 0)
        cf = CFrame.new(Vector3.new(position.X, result.Position.Y - depth, position.Z))
    end

    self.State.FloorCachePos = position
    self.State.FloorCacheCF = cf
    self.State.FloorCacheAt = now
    return cf
end

function S:AntiAimCombatActive()
    if not self.Config.AntiAimEnabled then return false end
    if self.Config.AntiAimOnlyCombat then
        local rage = self.Config.RageEnabled and self.State.RageTarget ~= nil
        local silent = self.Config.SilentEnabled and self.State.SilentTarget ~= nil
        if not rage and not silent then return false end
    end
    if self.Config.AntiAimOnlyAttack and self.Config.Enabled and self.State.Phase == "hide" then
        return false
    end
    return true
end

function S:GetAntiAimRotation(dt)
    if not self:AntiAimCombatActive() then return nil end

    local now = os.clock()
    local yawMode = tostring(self.Config.AntiAimYaw or "None")
    local yawAmount = math.clamp(tonumber(self.Config.AntiAimYawAngle) or 180, -360, 360)
    local jitterAmount = math.clamp(tonumber(self.Config.AntiAimJitterAngle) or 180, 0, 360)
    local speed = math.max(tonumber(self.Config.AntiAimSpeed) or 36, 0.1)
    local yaw = 0

    if yawMode == "Backwards" then
        yaw = math.pi
    elseif yawMode == "Offset" or yawMode == "Custom" then
        yaw = math.rad(yawAmount)
    elseif yawMode == "Spin" then
        self.State.AntiAimSpinAngle = ((self.State.AntiAimSpinAngle or 0) + speed * 18 * math.max(dt or 0, 0)) % 360
        yaw = math.rad(self.State.AntiAimSpinAngle)
    elseif yawMode == "Random" then
        if now >= (self.State.AntiAimNextRandom or 0) then
            self.State.AntiAimNextRandom = now + (1 / math.max(speed, 1))
            self.State.AntiAimRandomYaw = math.random(-18000, 18000) / 100
        end
        yaw = math.rad(self.State.AntiAimRandomYaw or 0)
    elseif yawMode == "Jitter" then
        if now >= (self.State.AntiAimNextJitter or 0) then
            self.State.AntiAimNextJitter = now + (1 / math.max(speed, 1))
            self.State.AntiAimJitterAngle = math.random(-math.floor(jitterAmount * 100), math.floor(jitterAmount * 100)) / 100
        end
        yaw = math.rad(self.State.AntiAimJitterAngle or 0)
    end

    local pitchMode = tostring(self.Config.AntiAimPitch or "None")
    local pitchAmount = math.clamp(tonumber(self.Config.AntiAimPitchAngle) or 89, 0, 89)
    local pitch = 0
    if pitchMode == "Up" or pitchMode == "Look Up" then
        pitch = math.rad(-pitchAmount)
    elseif pitchMode == "Down" or pitchMode == "Look Down" then
        pitch = math.rad(pitchAmount)
    elseif pitchMode == "Custom" or pitchMode == "Offset" then
        pitch = math.rad(math.clamp(tonumber(self.Config.AntiAimPitchAngle) or 0, -89, 89))
    elseif pitchMode == "Random" then
        if now >= (self.State.AntiAimNextPitch or 0) then
            self.State.AntiAimNextPitch = now + (1 / math.max(speed, 1))
            self.State.AntiAimRandomPitch = math.random(-pitchAmount * 100, pitchAmount * 100) / 100
        end
        pitch = math.rad(self.State.AntiAimRandomPitch or 0)
    elseif pitchMode == "Jitter" then
        if now >= (self.State.AntiAimNextPitch or 0) then
            self.State.AntiAimNextPitch = now + (1 / math.max(speed, 1))
            self.State.AntiAimRandomPitch = -(self.State.AntiAimRandomPitch == pitchAmount and pitchAmount or -pitchAmount)
        end
        pitch = math.rad(tonumber(self.State.AntiAimRandomPitch) or pitchAmount)
    end

    local rollMode = tostring(self.Config.AntiAimRoll or "None")
    local rollAmount = math.clamp(tonumber(self.Config.AntiAimRollAngle) or 0, -180, 180)
    local roll = 0
    if rollMode == "Tilt" or rollMode == "Custom" then
        roll = math.rad(rollAmount)
    elseif rollMode == "Sway" then
        roll = math.rad(math.sin(now * math.max(speed / 6, 0.1)) * rollAmount)
    elseif rollMode == "Spin" then
        roll = math.rad(((now * speed * 10) % 360) - 180)
    end

    return CFrame.Angles(pitch, yaw, roll)
end

function S:ApplyServerRotations(cf, dt)
    if not cf then return cf end

    local anti = self:GetAntiAimRotation(dt)
    if anti then
        cf = cf * anti
    end

    local spin = self:GetSpinRotation(dt, false)
    if spin then
        cf = cf * spin
    end
    return cf
end

function S:ComputeServerCFrame(root, dt)
    local visible = self.State.VisibleCF or (root and root.CFrame) or CFrame.new()
    local serverCF = visible

    if self.Config.RageEnabled and self.State.Phase ~= "hide" then
        serverCF = self:BuildRageAttackCFrame(root, dt)
    elseif self.Config.SilentEnabled and self.Config.SilentManipulation and self.State.Phase ~= "hide" then
        serverCF = self:BuildSilentManipulationCFrame(root)
    end

    if self.Config.Enabled and self.State.Phase == "hide" then
        -- Hide uses the stable reference pattern: random X/Z and a very deep Y while preserving rotation.
        local hideBase = serverCF
        local mode = tostring(self.Config.VoidMode or "Deep")
        if mode == "Extreme" then
            serverCF = self:BuildVoidCFrame(root)
        else
            local p = hideBase.Position
            local depth = math.max(tonumber(self.Config.VoidDepth) or 250000, 500)
            local range = math.max(tonumber(self.Config.VoidRange) or 9000, 100)
            local x, z = p.X, p.Z
            if mode == "Random" then
                x = math.random(-math.floor(range), math.floor(range))
                z = math.random(-math.floor(range), math.floor(range))
            end
            local y = mode == "Sky" and depth or -depth
            serverCF = CFrame.new(Vector3.new(x, y, z)) * (hideBase - hideBase.Position)
        end
    elseif self.Config.AntiAimEnabled and self.Config.AntiAimUnderground then
        local floor = self:GetFloorBelow(serverCF.Position)
        if floor then
            serverCF = floor * (serverCF - serverCF.Position)
        end
    end

    serverCF = self:ApplyServerRotations(serverCF, dt)
    return serverCF
end

function S:RestoreOwnedLocal(force)
    if not self.State.OwnRootFrame and not force then return end
    local root = self:GetRoot()
    if not root or not root.Parent then
        self.State.OwnRootFrame = false
        self.State.OwnsRoot = false
        return
    end

    local cf = self.State.LocalRestoreCF or self.State.VisibleCF
    pcall(function()
        if cf then root.CFrame = cf end
        if self.State.LocalRestoreLV then root.AssemblyLinearVelocity = self.State.LocalRestoreLV end
        if self.State.LocalRestoreAV then root.AssemblyAngularVelocity = self.State.LocalRestoreAV end
    end)

    self.State.OwnRootFrame = false
    if force then
        self.State.OwnsRoot = false
        self.State.LastOwnServerCF = nil
    end
end


function S:PreRenderExternalProbe()
    if not self.Running then return end
    if tostring(self.Config.CoexistenceMode or "Enhance") ~= "Enhance" then return end

    local root = self:GetRoot()
    if not root or not root.Parent then return end

    local visible = self.State.VisibleCF or self.State.LocalRestoreCF
    if not visible then return end

    local observed = root.CFrame
    local ownCF = self.State.LastOwnServerCF
    local threshold = math.max(tonumber(self.Config.ExternalDesyncThreshold) or 80, 10)
    local displacement = (observed.Position - visible.Position).Magnitude
    local looksLikeOurWrite = ownCF and (observed.Position - ownCF.Position).Magnitude < 6

    if displacement >= threshold and not looksLikeOurWrite then
        self:MarkExternalOwner(observed, "late server cf")
        self.State.ServerCF = observed
    end
end

function S:PostSimulationStep(dt)
    if not self.Running or not self:IsAlive() then
        self:RestoreOwnedLocal(true)
        return
    end

    self:UpdateCombatPhase()

    local root = self:GetRoot()
    if not root or not root.Parent then return end

    local observedCF = root.CFrame
    self.State.LastObservedCF = observedCF
    self.State.LastPostSimulation = os.clock()

    local external = self:DetectExternalServerState(root)
    if external then
        self.State.ServerCF = observedCF
        self.State.OwnsRoot = false
        self.State.OwnRootFrame = false
        self.State.LastStatus = "coexist: " .. tostring(self.State.ExternalReason or "external")
        return
    end

    -- Capture the real/local state only when another script has not already desynced it.
    self:SampleVisibleRoot(root, dt)
    self.State.LocalRestoreCF = root.CFrame
    self.State.LocalRestoreLV = root.AssemblyLinearVelocity
    self.State.LocalRestoreAV = root.AssemblyAngularVelocity

    if not self:ShouldOwnRoot() then
        self.State.ServerCF = root.CFrame
        self.State.OwnsRoot = false
        self.State.OwnRootFrame = false
        return
    end

    local serverCF = self:ComputeServerCFrame(root, dt)
    self.State.ServerCF = serverCF
    self.State.LastOwnServerCF = serverCF
    self.State.OwnsRoot = true
    self.State.OwnRootFrame = true

    pcall(function()
        root.CFrame = serverCF
        if self.Config.Enabled and self.State.Phase == "hide" and self.Config.VelocityNoise then
            local n = math.floor(math.max(tonumber(self.Config.VelocityNoiseAmount) or 2500, 0))
            root.AssemblyLinearVelocity = Vector3.new(
                math.random(-n, n),
                math.random(-n, n),
                math.random(-n, n)
            )
        end
    end)

    if self.Config.Enabled then
        self.State.LastStatus = self.State.Phase == "hide" and "void: hide" or "void: attack"
    elseif self.Config.AntiAimEnabled or self.Config.SpinEnabled then
        self.State.LastStatus = "anti aim"
    else
        self.State.LastStatus = "ready"
    end
end

function S:GetSpinRotation(dt, serverPulse)
    if not self.Config.SpinEnabled then return nil end
    if self.Config.SpinOnlyWhileVoid and self.State.Phase ~= "hide" then return nil end

    local now = os.clock()
    local mode = self.Config.SpinMode
    local dir = self.Config.SpinDirection == "Left" and -1 or 1
    local speed = math.max(tonumber(self.Config.SpinSpeed) or 720, 0)
    local range = math.clamp(tonumber(self.Config.SpinRange) or 180, 0, 360)
    local yaw = 0

    if mode == "Jitter" then
        if now >= self.State.JitterNext then
            self.State.JitterSign = -self.State.JitterSign
            self.State.JitterNext = now + math.max(tonumber(self.Config.JitterInterval) or 0.08, 0.01)
        end
        yaw = math.rad(range * self.State.JitterSign)
    elseif mode == "Random" then
        if now >= self.State.RandomNext then
            self.State.RandomYaw = math.random(-math.floor(range), math.floor(range))
            self.State.RandomNext = now + math.max(tonumber(self.Config.RandomInterval) or 0.12, 0.01)
        end
        yaw = math.rad(self.State.RandomYaw)
    elseif mode == "Sway" then
        yaw = math.rad(math.sin(now * math.max(speed / 90, 0.01)) * range)
    else
        if not serverPulse then
            self.State.SpinAngle = (self.State.SpinAngle + speed * dir * math.max(dt or 0, 0)) % 360
        end
        yaw = math.rad(self.State.SpinAngle)
    end

    local pitch = 0
    local pitchMode = self.Config.PitchMode
    local pitchAmount = math.clamp(tonumber(self.Config.PitchAmount) or 45, 0, 89)
    if pitchMode == "Up" then
        pitch = math.rad(-pitchAmount)
    elseif pitchMode == "Down" then
        pitch = math.rad(pitchAmount)
    elseif pitchMode == "Sine" then
        pitch = math.rad(math.sin(now * math.max(speed / 120, 0.1)) * pitchAmount)
    elseif pitchMode == "Jitter" then
        pitch = math.rad(pitchAmount * self.State.JitterSign)
    end

    local roll = 0
    local rollMode = self.Config.RollMode
    local rollAmount = math.clamp(tonumber(self.Config.RollAmount) or 25, 0, 180)
    if rollMode == "Tilt" then
        roll = math.rad(rollAmount * dir)
    elseif rollMode == "Spin" then
        if not serverPulse then
            self.State.RollAngle = (self.State.RollAngle + speed * 0.5 * dir * math.max(dt or 0, 0)) % 360
        end
        roll = math.rad(self.State.RollAngle)
    elseif rollMode == "Sway" then
        roll = math.rad(math.sin(now * math.max(speed / 150, 0.1)) * rollAmount)
    end

    return CFrame.Angles(pitch, yaw, roll)
end

function S:UpdateSpin(dt)
    local hum = self:GetHumanoid()
    local root = self:GetRoot()

    if not self.Config.SpinEnabled or not root or not hum then
        self:RestoreAutoRotate()
        return
    end
    if self.Config.SpinOnlyWhileVoid and self.State.Phase ~= "hide" then
        self:RestoreAutoRotate()
        return
    end
    if self:ExternalMovementBusy() then
        self:RestoreAutoRotate()
        return
    end

    if self.Config.DisableAutoRotate then
        if self.State.AutoRotateHumanoid ~= hum then
            self:RestoreAutoRotate()
            self.State.AutoRotateHumanoid = hum
            self.State.SavedAutoRotate = hum.AutoRotate
        end
        hum.AutoRotate = false
    end

    local rotation = self:GetSpinRotation(dt, false)
    if not rotation then return end

    local camera = self.Services.Workspace.CurrentCamera
    local cameraCF = self.Config.CameraSafe and camera and camera.CFrame or nil

    pcall(function()
        local pos = root.Position
        root.CFrame = CFrame.new(pos) * rotation
    end)

    if cameraCF and camera then
        pcall(function()
            camera.CFrame = cameraCF
        end)
    end
end

function S:RestoreAutoRotate()
    local hum = self.State.AutoRotateHumanoid
    if hum and hum.Parent and self.State.SavedAutoRotate ~= nil then
        pcall(function()
            hum.AutoRotate = self.State.SavedAutoRotate
        end)
    end
    self.State.AutoRotateHumanoid = nil
    self.State.SavedAutoRotate = nil
end

