end

function S:IsDevKageMenuOpen()
    if not self.Config.SyncWithDevKage then
        return self.State.FallbackVisible, false
    end
    local fn = ENV.InstanceIsMenuOpen
    if type(fn) == "function" then
        local ok, value = pcall(fn)
        if ok then
            return value == true, true
        end
    end
    return self.State.FallbackVisible, false
end

function S:GetAccent()
    local library = ENV.Library
    if type(library) == "table" and typeof(library.AccentColor) == "Color3" then
        return library.AccentColor
    end
    return Color3.fromRGB(0, 200, 255)
end

function S:ApplyAccent()
    local accent = self:GetAccent()
    for object, property in pairs(self.AccentObjects) do
        if object and object.Parent then
            pcall(function()
                object[property] = accent
            end)
        else
            self.AccentObjects[object] = nil
        end
    end
end

function S:Accent(object, property)
    if object then
        self.AccentObjects[object] = property or "BackgroundColor3"
        pcall(function()
            object[property or "BackgroundColor3"] = self:GetAccent()
        end)
    end
    return object
end

function S:Font()
    local fn = ENV.InstanceGetUiFont
    if type(fn) == "function" then
        local ok, value = pcall(fn)
        if ok and value then return value end
    end
    return Enum.Font.Roboto
end

