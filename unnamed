function S:GetMatchId(plr)
    if not plr then return nil end

    for _, key in ipairs(self.RageMatchIdAttributes) do
        local value = plr:GetAttribute(key)
        if value ~= nil and value ~= "" and value ~= 0 and value ~= false then
            return tostring(value)
        end
    end

    local char = plr.Character
    if char then
        for _, key in ipairs(self.RageMatchIdAttributes) do
            local value = char:GetAttribute(key)
            if value ~= nil and value ~= "" and value ~= 0 and value ~= false then
                return tostring(value)
            end
        end
    end
    return nil
end

function S:IsPlayerInLiveFolder(plr)
    if not plr then return false end
    local live = self.Services.Workspace:FindFirstChild("Live")
    if not live then return false end

    if live:FindFirstChild(plr.Name) or live:FindFirstChild(tostring(plr.UserId)) then
        return true
    end

    local char = plr.Character
    if char and (char.Parent == live or char:IsDescendantOf(live)) then
        return true
    end

    local fc = self.State.FighterController
    if fc and type(fc.GetFighter) == "function" then
        local ok, fighter = pcall(fc.GetFighter, fc, plr)
        if ok and fighter and fighter.Entity and fighter.Entity.Parent then
            if fighter.Entity.Parent == live or fighter.Entity:IsDescendantOf(live) then
                return true
            end
        end
    end

    return false
end

function S:IsActiveMatch()
    local plr = self.Player
    if not plr then return false end
    local char = plr.Character
    if not char then return false end

    for _, key in ipairs(self.RageSafeStateAttributes) do
        local value = plr:GetAttribute(key)
        local charValue = char:GetAttribute(key)
        if value == true or value == 1 or value == "true"
            or charValue == true or charValue == 1 or charValue == "true" then
            return false
        end
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not root then
        return false
    end

    for _, key in ipairs(self.RageActiveStateAttributes) do
        local value = plr:GetAttribute(key)
        local charValue = char:GetAttribute(key)
        if value == true or value == 1 or value == "true"
            or charValue == true or charValue == 1 or charValue == "true" then
            return true
        end
    end

    if self:IsPlayerInLiveFolder(plr) then
        return true
    end

    local myMatchId = self:GetMatchId(plr)
    if myMatchId then
        for _, other in ipairs(self.Services.Players:GetPlayers()) do
            if other ~= plr and self:GetMatchId(other) == myMatchId then
                return true
            end
        end
    end

    local fc = self.State.FighterController
    if fc then
        local localFighter = fc.LocalFighter
        if localFighter and localFighter.Entity and localFighter.Entity.Parent then
            return true
        end

        for _, list in ipairs({ fc.Fighters, fc.AllFighters }) do
            if type(list) == "table" then
                for _, fighter in pairs(list) do
                    if fighter and fighter.Player and fighter.Player ~= plr
                        and (fighter.IsEnemy or fighter.Enemy) then
                        local enemyChar = fighter.Player.Character
                        local enemyHum = enemyChar and enemyChar:FindFirstChildOfClass("Humanoid")
                        if enemyHum and enemyHum.Health > 0 then
                            return true
                        end
                    end
                end
            end
        end
    end

    return false
end

function S:IsTeammate(targetPlayer)
    if not targetPlayer or targetPlayer == self.Player then return true end
    if not self.Config.RageTeamCheck then return false end

    local myTeamId = self.Player and self.Player:GetAttribute("TeamID")
    local theirTeamId = targetPlayer:GetAttribute("TeamID")
    if myTeamId ~= nil and theirTeamId ~= nil and myTeamId == theirTeamId then
        return true
    end

    if self.Player and self.Player.Team and targetPlayer.Team and self.Player.Team == targetPlayer.Team then
        return true
    end
    return false
end

function S:IsTargetImmune(targetPlayer, char)
    char = char or (targetPlayer and targetPlayer.Character)
    if not char then return false end

    if char:FindFirstChildOfClass("ForceField") then
        return true
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    if root and root:FindFirstChild("Attachment") then
        return true
    end

    for _, key in ipairs({
        "Invulnerable", "Immune", "IsImmune", "GodMode", "SpawnProtected",
        "Protected", "InSafeZone"
    }) do
        local a = char:GetAttribute(key)
        local b = targetPlayer and targetPlayer:GetAttribute(key)
        if a == true or a == 1 or a == "true"
            or b == true or b == 1 or b == "true" then
            return true
        end
    end

    return false
end

function S:WorldToScreen(position)
    local camera = self.Services.Workspace.CurrentCamera
    if not camera then return nil, false end

    local custom = ENV.InstanceWorldToScreen
    if type(custom) == "function" then
        local ok, point, visible = pcall(custom, position, camera)
        if ok and point then
            return Vector2.new(point.X, point.Y), visible == true
        end
    end

    local point, visible = camera:WorldToViewportPoint(position)
    return Vector2.new(point.X, point.Y), visible == true and point.Z > 0
end

function S:IsValidRageTarget(char)
    if not char or not char.Parent then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not root then return false end

    local targetPlayer = self.Services.Players:GetPlayerFromCharacter(char)
    if not targetPlayer or targetPlayer == self.Player then return false end
    if self:IsTeammate(targetPlayer) then return false end

    local myRoot = self:GetRoot()
    local maxDistance = math.max(tonumber(self.Config.RageMaxDistance) or 2500, 0)
    if maxDistance > 0 and myRoot and (root.Position - myRoot.Position).Magnitude > maxDistance then
        return false
    end

    if self.Config.RageRequireOnScreen then
        local _, onScreen = self:WorldToScreen(root.Position)
        if not onScreen then return false end
    end

    return true
end

function S:GetRageHitPart(char)
    if not char then return nil end
    local name = self.Config.RageHitPart

    if name == "Closest" then
        local myRoot = self:GetRoot()
        local closest, best = nil, math.huge
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local d = myRoot and (part.Position - myRoot.Position).Magnitude or 0
                if d < best then
                    best = d
                    closest = part
                end
            end
        end
        return closest or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    elseif name == "Random" then
        local options = { "Head", "HumanoidRootPart", "UpperTorso", "Torso" }
        for _ = 1, #options do
            local pick = options[math.random(1, #options)]
            local part = char:FindFirstChild(pick)
            if part and part:IsA("BasePart") then
                return part
            end
        end
    end

    return char:FindFirstChild(name)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
end

function S:ScoreRageTarget(char)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return math.huge end

    local mode = self.Config.RageTargetMode
    if mode == "Lowest HP" then
        local hum = char:FindFirstChildOfClass("Humanoid")
        return hum and hum.Health or math.huge
    elseif mode == "Distance" then
        local myRoot = self:GetRoot()
        return myRoot and (root.Position - myRoot.Position).Magnitude or math.huge
    elseif mode == "Random" then
        return math.random()
    end

    local point, onScreen = self:WorldToScreen(root.Position)
    if not point or not onScreen then
        return math.huge
    end

    local cursor = self.Services.UserInputService:GetMouseLocation()
    local distance = (point - Vector2.new(cursor.X, cursor.Y)).Magnitude
    local fov = math.max(tonumber(self.Config.RageFOV) or 650, 0)
    if fov > 0 and distance > fov then
        return math.huge
    end
    return distance
end

function S:AcquireRageTarget(force)
    local now = os.clock()
    local delay = math.max(tonumber(self.Config.RageReacquireDelay) or 0.08, 0)
    if not force and now - (self.State.RageLastAcquire or 0) < delay then
        return self.State.RageTarget
    end
    self.State.RageLastAcquire = now

    local bestChar, bestScore = nil, math.huge
    for _, targetPlayer in ipairs(self.Services.Players:GetPlayers()) do
        if targetPlayer ~= self.Player and targetPlayer.Character then
            local char = targetPlayer.Character
            if self:IsValidRageTarget(char) then
                local score = self:ScoreRageTarget(char)
                if score < bestScore then
                    bestChar = char
                    bestScore = score
                end
            end
        end
    end

    self.State.RageTarget = bestChar
    self.State.RageTargetPlayer = bestChar and self.Services.Players:GetPlayerFromCharacter(bestChar) or nil

    if bestChar then
        local hum = bestChar:FindFirstChildOfClass("Humanoid")
        self.State.RageLastTargetName = self.State.RageTargetPlayer and self.State.RageTargetPlayer.Name or bestChar.Name
        self.State.RageLastTargetHP = hum and hum.Health or 0
        self.State.RageLastStatus = "locked"
    else
        self.State.RageLastTargetName = "-"
        self.State.RageLastTargetHP = 0
        self.State.RageLastStatus = "searching"
    end

    return bestChar
end

function S:ClearRageTarget()
    self.State.RageTarget = nil
    self.State.RageTargetPlayer = nil
    self.State.RageLastTargetName = "-"
    self.State.RageLastTargetHP = 0
end

function S:GetLocalFighter()
    local fc = self.State.FighterController
    return fc and fc.LocalFighter or nil
end

function S:ItemGet(item, key)
    if not item then return nil end
    local ok, value = pcall(function()
        if type(item.Get) == "function" then
            return item:Get(key)
        end
        return item[key]
    end)
    return ok and value or nil
end

function S:IsMeleeItem(item)
    if not item then return false end
    local name = tostring(self:ItemGet(item, "Name") or item.Name or "")
    if self.RageMeleeNames[name] then return true end
    if string.find(string.lower(name), "melee", 1, true) then return true end

    local itemType = tostring(self:ItemGet(item, "ItemType") or self:ItemGet(item, "Type") or self:ItemGet(item, "Category") or "")
    return string.find(string.lower(itemType), "melee", 1, true) ~= nil
end

function S:GetEquippedItem()
    local lf = self:GetLocalFighter()
    return lf and lf.EquippedItem or nil
end

function S:GetRageAmmo()
    local item = self:GetEquippedItem()
    if not item then return 0, 0, false, false end

    local name = tostring(self:ItemGet(item, "Name") or item.Name or "")
    local melee = self:IsMeleeItem(item)
    if self.RageInfiniteAmmoNames[name] then
        return nil, nil, false, false
    end

    local current = tonumber(self:ItemGet(item, "CurrentAmmo") or self:ItemGet(item, "Ammo"))
    local maximum = tonumber(self:ItemGet(item, "MaxAmmo") or self:ItemGet(item, "MaxBullets"))
    local reloading = false
    for _, key in ipairs({ "Reloading", "IsReloading", "IsReload" }) do
        local value = self:ItemGet(item, key)
        if value == true or value == 1 or value == "true" then
            reloading = true
            break
        end
    end

    if melee then
        return nil, nil, true, false
    end
    return current, maximum, false, reloading
end

function S:GetDesiredRageSlot()
    local pick = self.Config.RageWeaponPick
    if pick == "Secondary" then return 2 end
    if pick == "Melee" then return 3 end
    if pick == "Current" then return nil end
    return 1
end

function S:GetFighterItems()
    local lf = self:GetLocalFighter()
    return lf and lf.Items or nil
end

function S:FindRageSlotItem(slot)
    local items = self:GetFighterItems()
    if not items or not slot then return nil end

    if items[slot] then return items[slot] end
    if items[tostring(slot)] then return items[tostring(slot)] end

    for key, item in pairs(items) do
        if item then
            local itemSlot = tonumber(
                self:ItemGet(item, "Slot")
                or self:ItemGet(item, "Index")
                or self:ItemGet(item, "ItemSlot")
                or key
            )
            if itemSlot == slot then return item end

            local itemType = tostring(self:ItemGet(item, "ItemType") or self:ItemGet(item, "Type") or "")
            local lowType = string.lower(itemType)
            if slot == 3 and string.find(lowType, "melee", 1, true) then return item end
            if slot == 1 and (itemType == "Primary" or itemType == "1") then return item end
            if slot == 2 and (itemType == "Secondary" or itemType == "2") then return item end
        end
    end

    return nil
end

function S:GetItemSlot(item)
    if not item then return nil end
    if self:IsMeleeItem(item) then return 3 end

    local items = self:GetFighterItems()
    local objectId = self:ItemGet(item, "ObjectID")
    if items and objectId ~= nil then
        for slot = 1, 3 do
            local candidate = items[slot] or items[tostring(slot)]
            if candidate and self:ItemGet(candidate, "ObjectID") == objectId then
                return slot
            end
        end
    end

    return tonumber(
        self:ItemGet(item, "Slot")
        or self:ItemGet(item, "Index")
        or self:ItemGet(item, "ItemSlot")
    )
end

function S:ToGameEnum(name)
    local enums = self.State.EnumLibrary
    if not enums then return nil end

    local ok, value = pcall(function()
        if type(enums.ToEnum) == "function" then
            return enums:ToEnum(name)
        end
        return nil
    end)
    return ok and value or nil
end

function S:EquipRageWeapon()
    if not self.Config.RageForceWeapon then return true end

    local slot = self:GetDesiredRageSlot()
    if not slot then return true end

    local lf = self:GetLocalFighter()
    if not lf then return false end

    local equipped = lf.EquippedItem
    if equipped and self:GetItemSlot(equipped) == slot then
        return true
    end

    local now = os.clock()
    if now - (self.State.RageLastEquip or 0) < 0.08 then
        return false
    end
    self.State.RageLastEquip = now

    local desired = self:FindRageSlotItem(slot)

    pcall(function()
        if type(lf.SwitchToSlot) == "function" then lf:SwitchToSlot(slot) end
    end)
    pcall(function()
        if type(lf.EquipItem) == "function" then lf:EquipItem(slot) end
    end)
    pcall(function()
        if type(lf.Equip) == "function" then lf:Equip(slot) end
    end)

    local fc = self.State.FighterController
    if fc then
        pcall(function()
            if type(fc.SwitchItem) == "function" then fc:SwitchItem(slot) end
        end)
        pcall(function()
            if type(fc.EquipItem) == "function" then fc:EquipItem(slot) end
        end)
    end

    local useItem = self.Services.ReplicatedStorage
        and self.Services.ReplicatedStorage:FindFirstChild("Remotes")
    useItem = useItem and useItem:FindFirstChild("Replication")
    useItem = useItem and useItem:FindFirstChild("Fighter")
    useItem = useItem and useItem:FindFirstChild("UseItem")

    local objectId = desired and self:ItemGet(desired, "ObjectID")
    if useItem and objectId ~= nil then
        for _, enumName in ipairs({ "Equip", "Switch", "Select", "EquipItem", "ChangeItem" }) do
            local enumValue = self:ToGameEnum(enumName)
            if enumValue ~= nil then
                pcall(function()
                    useItem:FireServer(objectId, enumValue, nil, nil)
                end)
            end
        end
    end

    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local key = ({ Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three })[slot]
        if key then
            vim:SendKeyEvent(true, key, false, game)
            task.defer(function()
                pcall(function()
                    vim:SendKeyEvent(false, key, false, game)
                end)
            end)
        end
    end)

    return true
end

function S:GetMuzzlePosition()
    local viewModels = self.Services.Workspace:FindFirstChild("ViewModels")
    local firstPerson = viewModels and viewModels:FindFirstChild("FirstPerson")
    if not firstPerson then return nil end

    local playerName = self.Player and self.Player.Name or ""
    for _, model in ipairs(firstPerson:GetChildren()) do
        if model:IsA("Model") then
            local name = model.Name or ""
            local belongs = playerName == "" or string.find(name, playerName, 1, true) ~= nil
            if belongs then
                local itemVisual = model:FindFirstChild("ItemVisual")
                local body = itemVisual and itemVisual:FindFirstChild("Body")
                local primary = body and body:FindFirstChild("BodyPrimary")
                local muzzle = primary and primary:FindFirstChild("_muzzle")

                if muzzle and muzzle:IsA("Attachment") then
                    return muzzle.WorldPosition
                elseif muzzle and muzzle:IsA("BasePart") then
                    return muzzle.Position
                end

                for _, desc in ipairs(model:GetDescendants()) do
                    local low = string.lower(desc.Name or "")
                    if string.find(low, "muzzle", 1, true) or string.find(low, "barrel", 1, true) then
                        if desc:IsA("Attachment") then
                            return desc.WorldPosition
                        elseif desc:IsA("BasePart") then
                            return desc.Position
                        end
                    end
                end
            end
        end
    end
    return nil
end

function S:GetRageOrigin()
    local mode = self.Config.RageOrigin
    if mode == "Muzzle" then
        local muzzle = self:GetMuzzlePosition()
        if muzzle then return muzzle end
    elseif mode == "Root" then
        local root = self:GetRoot()
        if root then return root.Position end
    end
    return self:GetVisibleOrigin()
end

function S:PredictRagePart(part, origin)
    if not part or typeof(part) ~= "Instance" or not part:IsA("BasePart") then
        return nil
    end

    local base = part.Position
    if not self.Config.RagePrediction then
        return base
    end

    origin = origin or self:GetRageOrigin()
    local distance = (base - origin).Magnitude
    local leadTime = 0

    if self.Config.ProjectileAssist then
        local speed = math.max(tonumber(self.Config.ProjectileSpeed) or 3000, 1)
        leadTime = leadTime + (distance / speed)
    end
    if self.Config.PingAssist then
        leadTime = leadTime + (self:GetPing() * math.max(tonumber(self.Config.PingFactor) or 1, 0))
    end

    leadTime = leadTime
        * math.max(tonumber(self.Config.PredictionMultiplier) or 1, 0)
        * math.max(tonumber(self.Config.RagePredictionScale) or 1, 0)
    leadTime = math.min(leadTime, math.max(tonumber(self.Config.PredictionMaxLead) or 0.35, 0))

    local velocity = self:GetTargetVelocity(part)
    local offset = velocity * leadTime
    local cap = math.max(tonumber(self.Config.MaxPredictionStuds) or 18, 0)
    if cap > 0 and offset.Magnitude > cap then
        offset = offset.Unit * cap
    end

    return base + offset
end

function S:EncodeRageCFrame(cf)
    local utility = self.State.Utility
    if not utility then return cf end

    local ok, value = pcall(function()
        if type(utility.EncodeCFrame) == "function" then
            return utility:EncodeCFrame(cf)
        end
        return cf
    end)
    return ok and value or cf
end

function S:GetUseItemRemote()
    local rs = self.Services.ReplicatedStorage
    local remotes = rs and rs:FindFirstChild("Remotes")
    local replication = remotes and remotes:FindFirstChild("Replication")
    local fighter = replication and replication:FindFirstChild("Fighter")
    return fighter and fighter:FindFirstChild("UseItem") or nil
end

function S:CanRageFire()
    if not self.Config.RageEnabled or not self.Config.RageAutoShoot then
        return false, "off"
    end

    if self.Config.RageVoidSync and self.Config.Enabled and self.State.Phase == "hide" then
        return false, "void hide"
    end

    local item = self:GetEquippedItem()
    if not item then return false, "no weapon" end

    local current, _, melee, reloading = self:GetRageAmmo()
    if reloading then return false, "reloading" end
    if not melee and current ~= nil and current <= 0 then return false, "no ammo" end

    local now = os.clock()
    local interval = math.max(tonumber(self.Config.RageShotInterval) or 0.055, 0.01)
    if now - (self.State.RageLastShot or 0) < interval then
        return false, "cooldown"
    end

    return true, "ready"
end

function S:FireRageShot()
    local target = self.State.RageTarget
    if not self:IsValidRageTarget(target) then
        return false, "invalid target"
    end

    local targetPlayer = self.State.RageTargetPlayer
    if self.Config.RageRespectImmune and self:IsTargetImmune(targetPlayer, target) then
        return false, "immune"
    end

    if self.Config.RageForceWeapon then
        self:EquipRageWeapon()
    end

    local canFire, reason = self:CanRageFire()
    if not canFire then return false, reason end

    local item = self:GetEquippedItem()
    local objectId = item and self:ItemGet(item, "ObjectID")
    if objectId == nil then return false, "object id" end

    local hitPart = self:GetRageHitPart(target)
    if not hitPart then return false, "hit part" end

    local origin = self:GetRageOrigin()
    local targetPos = self:PredictRagePart(hitPart, origin)
    if not origin or not targetPos then return false, "prediction" end

    local startShooting = self:ToGameEnum("StartShooting")
    if startShooting == nil then
        self:RefreshCombatModules()
        startShooting = self:ToGameEnum("StartShooting")
    end
    if startShooting == nil then return false, "enum" end

    local remote = self:GetUseItemRemote()
    if not remote then return false, "remote" end

    local look = CFrame.new(origin, targetPos)
    local data = {
        [utf8.char(1)] = {
            [utf8.char(0)] = self:EncodeRageCFrame(look),
            [utf8.char(1)] = self:EncodeRageCFrame(look),
            [utf8.char(2)] = hitPart,
            [utf8.char(3)] = self:EncodeRageCFrame(CFrame.new(0.43, 0.25, 0.42)),
        },
    }

    local attempts = math.clamp(math.floor(tonumber(self.Config.RageShootAttempts) or 1), 1, 3)
    local fired = false
    local lastError = nil

    for _ = 1, attempts do
        local ok, err = pcall(function()
            remote:FireServer(objectId, startShooting, data, nil)
        end)
        if ok then
            fired = true
        else
            lastError = err
        end
    end

    if fired then
        self.State.RageLastShot = os.clock()
        self.State.RageLastFireError = nil
        return true, "firing"
    end

    self.State.RageLastFireError = tostring(lastError)
    return false, "fire error"
end

function S:UpdateRage(dt)
    if not self.Config.RageEnabled then
        if self.State.RageTarget then
            self:ClearRageTarget()
        end
        self.State.RageLastStatus = "off"
        return
    end

    if self.Config.RageMatchOnly and not self:IsActiveMatch() then
        self:ClearRageTarget()
        self.State.RageLastStatus = "waiting match"
        return
    end

    if not self:IsAlive() then
        self:ClearRageTarget()
        self.State.RageLastStatus = "waiting fighter"
        return
    end

    local target = self.State.RageTarget
    local valid = target and self:IsValidRageTarget(target)

    if valid and self.Config.RageRespectImmune
        and self:IsTargetImmune(self.State.RageTargetPlayer, target) then
        self.State.RageLastStatus = "target immune"
        if not self.Config.RageStickyTarget and self.Config.RageAutoTarget then
            self:ClearRageTarget()
            target = nil
            valid = false
        end
    end

    if self.Config.RageAutoTarget then
        if not valid or not self.Config.RageStickyTarget then
            target = self:AcquireRageTarget(false)
            valid = target and self:IsValidRageTarget(target)
        end
    elseif not valid then
        self:ClearRageTarget()
        target = nil
    end

    if not target then
        self.State.RageLastStatus = "searching"
        return
    end

    local hum = target:FindFirstChildOfClass("Humanoid")
    self.State.RageLastTargetName = self.State.RageTargetPlayer and self.State.RageTargetPlayer.Name or target.Name
    self.State.RageLastTargetHP = hum and hum.Health or 0

    if self.Config.RageVoidSync and self.Config.Enabled and self.State.Phase == "hide" then
        self.State.RageLastStatus = "void hide"
        return
    end

    if self.Config.RageForceWeapon then
        self:EquipRageWeapon()
    end

    if self.Config.RageAutoShoot then
        local fired, status = self:FireRageShot()
        self.State.RageLastStatus = status or (fired and "firing" or "ready")
    else
        self.State.RageLastStatus = "locked"
    end
end

function S:GetSpinRotation(dt, serverPulse)
    if not self.Config.SpinEnabled then return nil end
    if self.Config.SpinOnlyWhileVoid and self.State.Phase ~= "hide" then return nil end

    local now = os.clock()
    local mode = self.Config.SpinMode
    local dir = self.Config.SpinDirection == "Left" and -1 or 1
    local speed = math.max(tonumber(self.Config.SpinSpeed) or 720, 0)
    local range = math.clamp(tonumber(self.Config.SpinRange) or 180, 0, 360)
    local yaw = 0

    if mode == "Jitter" then
        if now >= self.State.JitterNext then
            self.State.JitterSign = -self.State.JitterSign
            self.State.JitterNext = now + math.max(tonumber(self.Config.JitterInterval) or 0.08, 0.01)
        end
        yaw = math.rad(range * self.State.JitterSign)
    elseif mode == "Random" then
        if now >= self.State.RandomNext then
            self.State.RandomYaw = math.random(-math.floor(range), math.floor(range))
            self.State.RandomNext = now + math.max(tonumber(self.Config.RandomInterval) or 0.12, 0.01)
        end
        yaw = math.rad(self.State.RandomYaw)
    elseif mode == "Sway" then
        yaw = math.rad(math.sin(now * math.max(speed / 90, 0.01)) * range)
    else
        if not serverPulse then
            self.State.SpinAngle = (self.State.SpinAngle + speed * dir * math.max(dt or 0, 0)) % 360
        end
        yaw = math.rad(self.State.SpinAngle)
    end

    local pitch = 0
    local pitchMode = self.Config.PitchMode
    local pitchAmount = math.clamp(tonumber(self.Config.PitchAmount) or 45, 0, 89)
    if pitchMode == "Up" then
        pitch = math.rad(-pitchAmount)
    elseif pitchMode == "Down" then
        pitch = math.rad(pitchAmount)
    elseif pitchMode == "Sine" then
        pitch = math.rad(math.sin(now * math.max(speed / 120, 0.1)) * pitchAmount)
    elseif pitchMode == "Jitter" then
        pitch = math.rad(pitchAmount * self.State.JitterSign)
    end

    local roll = 0
    local rollMode = self.Config.RollMode
    local rollAmount = math.clamp(tonumber(self.Config.RollAmount) or 25, 0, 180)
    if rollMode == "Tilt" then
        roll = math.rad(rollAmount * dir)
    elseif rollMode == "Spin" then
        if not serverPulse then
            self.State.RollAngle = (self.State.RollAngle + speed * 0.5 * dir * math.max(dt or 0, 0)) % 360
        end
        roll = math.rad(self.State.RollAngle)
    elseif rollMode == "Sway" then
        roll = math.rad(math.sin(now * math.max(speed / 150, 0.1)) * rollAmount)
    end

    return CFrame.Angles(pitch, yaw, roll)
end

function S:UpdateSpin(dt)
    local hum = self:GetHumanoid()
    local root = self:GetRoot()

    if not self.Config.SpinEnabled or not root or not hum then
        self:RestoreAutoRotate()
        return
    end
    if self.Config.SpinOnlyWhileVoid and self.State.Phase ~= "hide" then
        self:RestoreAutoRotate()
        return
    end
    if self:ExternalMovementBusy() then
        self:RestoreAutoRotate()
        return
    end

    if self.Config.DisableAutoRotate then
        if self.State.AutoRotateHumanoid ~= hum then
            self:RestoreAutoRotate()
            self.State.AutoRotateHumanoid = hum
            self.State.SavedAutoRotate = hum.AutoRotate
        end
        hum.AutoRotate = false
    end

    local rotation = self:GetSpinRotation(dt, false)
    if not rotation then return end

    local camera = self.Services.Workspace.CurrentCamera
    local cameraCF = self.Config.CameraSafe and camera and camera.CFrame or nil

    pcall(function()
        local pos = root.Position
        root.CFrame = CFrame.new(pos) * rotation
    end)

    if cameraCF and camera then
        pcall(function()
            camera.CFrame = cameraCF
        end)
    end
end

