function S:GetHitPartByName(char, name)
    if not char then return nil end
    name = tostring(name or "Head")

    local function fc(n)
        local part = char:FindFirstChild(n)
        return part and part:IsA("BasePart") and part or nil
    end

    if name == "Torso" then
        return fc("Torso") or fc("UpperTorso") or fc("HumanoidRootPart")
    elseif name == "Closest" then
        local camera = self.Services.Workspace.CurrentCamera
        local camPos = camera and camera.CFrame.Position
        local camLook = camera and camera.CFrame.LookVector
        local best, bestD = nil, math.huge
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local d
                if camPos and camLook and (part.Position - camPos).Magnitude > 0.001 then
                    d = 1 - camLook:Dot((part.Position - camPos).Unit)
                else
                    local myRoot = self:GetRoot()
                    d = myRoot and (part.Position - myRoot.Position).Magnitude or 0
                end
                if d < bestD then
                    bestD = d
                    best = part
                end
            end
        end
        return best or fc("Head") or fc("HumanoidRootPart")
    elseif name == "Random" then
        local parts = {}
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                parts[#parts + 1] = part
            end
        end
        if #parts > 0 then
            return parts[math.random(1, #parts)]
        end
    end

    return fc(name) or fc("Head") or fc("HumanoidRootPart")
end

